	isbn = {9780443137778 (ISBN); 9780443137761 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105028816478&doi=10.1016%2FB978-0-44-313776-1.00256-7&partnerID=40&md5=8e94979d1e63d204a2ec0ce05c4bc0b7},
	doi = {10.1016/B978-0-44-313776-1.00256-7},
	abstract = {Eight indicators corresponding to the objectives of the “Europe 2020” Strategy were employed to evaluate the divergence of EU Member States from their specified targets. Findings from the study revealed the following trends: (i) Progress toward the employment target of 75\% for individuals aged 20–64 has advanced, though the goal remains unmet; (ii) Research and Development (R\&D) expenditure as a percentage of GDP lingers below the 3\% target; (iii) The intended reduction of greenhouse gas emissions in Energy-Related and Industrial Processes (ESD) sectors by 20\% compared to 1990 levels was not realized; (iv) The objective of reaching a 20\% share of renewable energy in final consumption has been attained; (v) Strides toward a 20\% improvement in energy efficiency have been successfully achieved; (vi) The aim to reduce school dropout rates to below 10\% has been met; (vii) The target of having at least 40\% of the population aged 30–34 complete tertiary education has been realized; (viii) The aspiration to uplift at least 20 million people from the risk of poverty fell short. Graphical representations show the results for all indicators across all EU27 Member States, with separate depictions of changes in the EU27 average indicator. Additionally, a numerical and graphical ranking utilizing Geographic Information System (GIS) is provided for each indicator. © 2025 Elsevier Inc. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	language = {English},
	booktitle = {Encyclopedia of {Monetary} {Policy}, {Financial} {Markets} and {Banking}},
