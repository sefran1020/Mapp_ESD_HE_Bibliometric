	year = {2026},
	keywords = {Artificial intelligence, Bibliometric analysis, Renewable energy, Sustainable energy, Visualization},
	file = {Snapshot:E\:\\Zotero\\storage\\6352L4S7\\105029082412.html:text/html},
}

