	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: K. Ásványi; Institute of Sustainable Development, Corvinus University of Budapest, Budapest, Hungary; email: katalin.asvanyi@uni-corvinus.hu},
}

@incollection{ferrari_can_2025,
	title = {Can {Climate} {Anxiety} and {Awareness} {Drive} {Academic} {Behaviour} in {Higher} {Education}?},
	volume = {Part F819},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014425419&doi=10.1007%2F978-3-031-86985-3_4&partnerID=40&md5=5ad7d7efe9c2419d1f0e798758302a1d},
	doi = {10.1007/978-3-031-86985-3_4},
	abstract = {Climate change is one of the most pressing global challenges that requires urgent action from individuals, organizations, and institutions. In the context of higher education, students, professors, and researchers play a crucial role in advancing climate action through their learning, teaching, and research endeavours. However, we know little about the factors that influence their engagement and commitment to climate and sustainability action. This study aims to fill this gap by identifying and analysing the specific factors that influence climate action among students and staff in higher education, with the objective of developing effective strategies to enhance their involvement. The study draws on the results of an online survey in which 9121 students and academics from six universities in Europe and Latin America participated. The results show that climate education and research demonstrated associations with early and mid-career researchers, duration of work/study, and academic discipline, with engineering staff and students showing the highest level of involvement. Moreover, we found that climate anxiety and awareness of climate research groups significantly explain academic behaviour among students and academics. These findings inform targeted approaches to mobilize action within higher education institutions by focusing on the identified influencing factors. The outcomes emphasize the criticality of enhancing climate literacy and sustainability initiatives within higher education through tailored strategies that address these key factors. Higher education institutions are responsible for incorporating climate education, research, and sustainable practices to address the urgent issues of sustainability and climate change. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Ferrari, E. and Whitmarsh, L. and MacCann-Alfaro, N. and Cáceres-González, C. and Melara, E. and Hernadez-Gallego, E. and Ruíz, C.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Climate action, Climate anxiety, Climate change, Higher education, University research},
	pages = {59--74},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: E. Ferrari; EMC3 Research Group and Department of Math and Science Education, Universidad de Salamanca, Salamanca, Spain; email: enzoferrari@usal.es},
}

@incollection{borsari_student-centered_2025,
	title = {Student-{Centered} {Teaching} for {Sustainability} {Education} in an {Introductory} {Biology} {Course} at {Winona} {State} {University}: {A} {Case}-{Study}},
	volume = {Part F819},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014336211&doi=10.1007%2F978-3-031-86985-3_3&partnerID=40&md5=06480d148fe64412e2ae3cb9eba556e9},
	doi = {10.1007/978-3-031-86985-3_3},
	abstract = {Sustainability education has emerged as a common denominator among higher education institutions (HEIs) in the twenty-first century to prepare all citizens adapting to the vagaries of climate change and uncertainties brought by environmental and social shifts. The purpose of this chapter consisted in showcasing selected student-centered pedagogies in a freshman biology course that in the author’s experience were effective for stimulating an education in sustainability. These aimed at enhancing awareness about sustainable development among undergraduate students at Winona State University. Between 2005 and 2019, the author served as coordinator of introductory biology courses that enrolled about 7000 students as non-science majors, or undecided. Framed by constructivism theory and the SDGs of UN Agenda 2030, four student-centered teaching methods were employed consistently, while connecting across disciplines to make learning relevant to most students, through the years. Data collected from students’ assignments were substantiated by the number of scholarly publications produced by the author within this 14-year timeframe with colleagues from the Biology Department at WSU and others. This effort demonstrates an achievement of quality education for sustainable development, while fulfilling SDG 4 and its targets. A distinctive model is presented in conclusion to this work to highlight benefits and opportunities that could be gained in future efforts to implement sustainability teaching practices in the biological sciences and more curricula. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Borsari, B.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Biology, Case-study, Student-centered pedagogies, Sustainability education, Sustainable development, Teaching},
	pages = {39--58},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: B. Borsari; Winona State University, Winona, United States; email: bborsari@winona.edu},
}

@incollection{ferreira-corchero_educational_2025,
	title = {Educational {Tools} to {Develop} {Climate} {Literacy} {Among} {School} {Students}: {Science} {On} a {Sphere}},
	volume = {Part F642},
	isbn = {21964963 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011543126&doi=10.1007%2F978-981-96-5658-5_102&partnerID=40&md5=86a2b465cc765d5781effe0e70980fba},
	doi = {10.1007/978-981-96-5658-5_102},
	abstract = {Climate change (CC) poses a critical threat to global survival and well-being, necessitating urgent action to mitigate greenhouse gas emissions and adapt to its impacts. Education emerges as a vital tool in addressing this complex challenge, empowering individuals with the knowledge and skills necessary to foster sustainability and resilience. This paper explores the implementation of Science On a Sphere® (SOS) in the OmniGlobe® version at the University of Salamanca as an augmented reality (AR) educational tool aimed at enhancing climate literacy among pre-university students. SOS leverages AR and real-time data visualizations to engage students in understanding the intricacies of CC and environmental phenomena. By integrating scientific and social science knowledge, SOS fosters critical thinking, problem solving and proactive attitudes towards sustainability. The impact of the exhibition is primarily appreciated during school visits, where students actively engage with the interactive exhibits and participate in discussions on global environmental issues. This comprehensive approach underscores the transformative potential of SOS in CC education, paving the way for informed and empowered citizens capable of meeting the environmental challenges of the future. Continued support and expansion of such initiatives is essential to ensure a sustainable future for generations to come. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2025.},
	language = {English},
	booktitle = {Lect. {Notes} {Educ}. {Technol}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Ferreira-Corchero, R. and Ballegeer, A.-M. and Ruíz, C.},
	year = {2025},
	note = {Journal Abbreviation: Lect. Notes Educ. Technol.},
	keywords = {Climate Literacy, Educational Innovation, Science On a Sphere},
	pages = {1040--1049},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: R. Ferreira-Corchero; Universidad de Salamanca, Salamanca, Spain; email: rebeca.fc@usal.es},
}

@incollection{atuguba_green_2025,
	title = {Green {Changemakers}: {A} {Paradigm} {Shift} in {Vocational} {Education}},
	isbn = {9781800886650 (ISBN); 9781800886667 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010804653&doi=10.4337%2F9781800886667.00017&partnerID=40&md5=625dc4a54eca42eae163a26f8a7776d8},
	doi = {10.4337/9781800886667.00017},
	abstract = {Green Changemakers is a regional initiative in the West Midlands of England, an area that encompasses the sprawling diversity of Birmingham, former industrial towns and agricultural countryside. The original vision was to teach educators 'green skills', an outcome that the authors quickly problematized once they gathered in the welcoming surroundings of Fircroft College, an adult education college with a social purpose mission of helping adults to realize their potential, focus on themselves and help them make what once seemed impossible, possible. This beautiful former home and gardens of philanthropist George Cadbury enabled them to step away from busy lives and think together about previously unimagined futures. They began to question what these 'green skills' are. How can a generic approach honour the expertise of subject specialist educators, while enabling them to adapt to an unknown future, enabling students to make and justify sustainable choices? Rather than try to generically teach specialist green skills, they chose to focus on 'changemaking' skills. This chapter explores the rationale behind the Green Changemakers approach and how the authors are trying to put it into practice. 0000-0001-6447-9274, 0009-0009-4373-2512, 0000-0001-6279-9864,, 0009-0001-2171-2985. © Nalita James, Kevin Orr and Sharon Clancy 2025. All rights reserved.},
	language = {English},
	booktitle = {Res. {Handb}. on {Adult} {Learning} and {Education}},
	publisher = {Edward Elgar Publishing Ltd.},
	author = {Atuguba, J. and Cresswell, H. and Mycroft, L. and Sadiq, D. and Willis, J.},
	year = {2025},
	note = {Journal Abbreviation: Res. Handb. on Adult Learning and Education},
	keywords = {Agricultural engineering, Apprentices, Birmingham, Changemaking, Curricula, Curriculum, England, Environment, Green, Green manufacturing, Paradigm shifts, Personnel training, Regional planning, Skill, Skills, Students, Sustainable development, Teaching, Vocational education, Vocational education and training, Vocational education and training (VET)},
	pages = {102--112},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{bergli_challenge_2025,
	title = {The challenge of integration: {Teacher} students’ development in a whole-school approach to sustainable teacher education},
	volume = {19},
	shorttitle = {Integreringen som utfordring: {Lærerstudentenes} utvikling i en hel-skole-tilnærming til bærekraftig lærerutdanning},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105009297591&doi=10.5617%2Fadno.11386&partnerID=40&md5=e427ae6e741e18cfd900288d4b6575b1},
	doi = {10.5617/adno.11386},
	abstract = {Whole-school approaches to sustainable education entail a holistic approach to both education and teacher education, focusing on the connection between knowledge and action – and alignment between basic normative guidelines and adapted local contexts. In this article, we present and discuss a research and development work in which we theoretically and practically explore what integrating a whole-school approach to sustainability may mean for the teacher education programme at our university. We (1) clarify key dimensions of the integration challenge through a synthesis of theoretical perspectives from theory of sustainable education, teacher education, vocational didactics and pedagogy, and (2) argue that consistent use of action learning makes it possible to integrate different perspectives that should be taken into account when embedding sustainability thinking into our educational context. Furthermore, we (3) present and discuss an initial trial through a 3-year action learning cycle in the teacher education programme. Here, action learning is an integrative approach aimed at further developing the course of study with an emphasis on longitudinal progression and coherence between theory and practice. The first action learning cycle results in (4) guidelines for further R\&D work on integrating education for sustainable development through action learning locally. The article contributes to filling a recognised need in the literature for linking theoretical approaches and concrete examples of what embedding sustainability thinking in teacher education may entail. ©2025 Author(s).},
	language = {Norwegian},
	number = {2},
	journal = {Acta Didactica Norden},
	publisher = {Universitetet i Oslo},
	author = {Bergli, E. and Hugo, A. and Liland, M.},
	year = {2025},
	keywords = {action learning, critical reflection, sustainable teacher education, whole-school approach},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{diaz-clark_science_2025,
	title = {From {Science} to {Solutions}: {Teaching} {Climate} {Change} as {Simple}, {Serious}, and {Solvable}},
	volume = {54},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007654932&doi=10.1080%2F0047231X.2025.2514202&partnerID=40&md5=e0a605201e6ccd880ab8914f2315ed77},
	doi = {10.1080/0047231X.2025.2514202},
	abstract = {Climate change (CC) is a critical global challenge that necessitates climate literacy among college graduates. This paper presents a comprehensive curricular model for teaching CC in higher education, organized into three units: Simple, Serious, and Solvable (S3). The Simple unit covers the fundamental science linking carbon emissions to climate warming through hands-on activities and simulations. The Serious unit emphasizes the diverse impacts of CC across sectors like agriculture, water, health, and infrastructure, evaluating associated costs and ethical considerations. Students explore temperature projections, cascading effects, and environmental justice. The Solvable unit introduces mitigation and adaptation strategies, including renewable energy, energy efficiency, and sustainable practices. Interactive “toy models” incorporated throughout the course allow data manipulation to illustrate components of complex climate models and foster the development of quantitative skills. Writing assignments like climate fiction stories enable students to synthesize learning and articulate values. Overall, the interdisciplinary S3 model aims to build climate literacy through active learning, empowering students as informed stakeholders in confronting this global challenge. © 2025 National Science Teaching Association.},
	language = {English},
	number = {6},
	journal = {Journal of College Science Teaching},
	publisher = {Informa UK Ltd},
	author = {Diaz-Clark, E. and Balgopal, M.M. and Denning, A.S.},
	year = {2025},
	keywords = {Climate change education, Climate literacy, Toy model},
	pages = {506--511},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: E. Diaz-Clark; Graduate Degree Program in Ecology, Colorado State University, Fort Collins, United States; email: eddc@colostate.edu},
}

@article{cuadrado-ballesteros_bridging_2025,
	title = {Bridging knowledge and action: {Sustainable} development through learning landscapes in higher education},
	issn = {14703297 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007542038&doi=10.1080%2F14703297.2025.2516113&partnerID=40&md5=e71ed1b877111f2ca6deae14ea83a476},
	doi = {10.1080/14703297.2025.2516113},
	abstract = {Promoting education for sustainable development (ESD) is crucial to meet the Sustainable Development Goals (SDGs). One of the main features of ESD is the use of active methodologies, among which learning landscapes have recently been highlighted. This intervention study describes implementing a learning landscape to promote a critical understanding of sustainable development and the SDGs in several subjects at the University of Salamanca (Spain). The survey given at the end of the semester suggests that students were satisfied with this methodology, especially since it allowed them to personalise their learning process thanks to a wide range of diverse activities. In addition, they declared that the activities helped them gain a deeper understanding of the SDGs, which are underdeveloped in the degree programmes of Spanish universities. © 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
	language = {English},
	journal = {Innovations in Education and Teaching International},
	publisher = {Routledge},
	author = {Cuadrado-Ballesteros, B. and González-Bravo, M.-I. and Martínez-Ferrero, J. and Lahuerta-Otero, E.},
	year = {2025},
	keywords = {Bloom’s taxonomy, Education for sustainable development, learning landscape, multiple intelligences, sustainable development goals},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: B. Cuadrado-Ballesteros; Administration and Business Economics, Multidisciplinary Institute for Enterprise, University of Salamanca, Salamanca, Spain; email: u77171@usal.es},
}

@article{ahmad_education_2025,
	title = {Education for {Sustainable} {Development}: {Lifestyle} {Behaviors} of {Applied} {Science} {Private} {University} {Students} and {Correlate} them with {Academic} {Achievement}},
	volume = {21},
	issn = {17905079 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007208062&doi=10.37394%2F232015.2025.21.47&partnerID=40&md5=f807906abcc528c262d61aca302fe1e7},
	doi = {10.37394/232015.2025.21.47},
	abstract = {Background: High academic achievement is an important indicator of future success, which is affected by lifestyle behaviors. A healthy lifestyle is associated with higher cumulative averages among college students. Objectives of the current study: To explore the dietary habits of university students, the effect of sleep and physical activity, and the associations with students' academic achievement. Method: An electronic survey was used to conduct a cross-sectional study of applied science university students. We studied the effect of the family's income level and parents' educational attainment and evaluated students' diet, sleep, and physical activity on their academic achievement. Result: A total of 164 students were female 59.8\% and male 40.2\%. Respondents were affiliated with the divisions of humanities faculties (58/164, 35.4\%) and scientific faculties (106/164, 64.6\%). The percentage of students over 20 years old was 57.3\%. 34.1\% of the total sample had a cumulative average of 68-75.9, and 30.5\% had a cumulative average of greater than or equal to 84. 47.6\% of students had a family income between 500-1000. Males favor consuming 6-8 glasses of water daily, eating three times fast food weekly, consuming energy drinks, sleeping in the dark, sticking to one type of sport, and meeting new friends in the gym. Females fight stress by eating, taking a daily nap, and taking vitamins and nutritional supplements. Students whose cumulative averages are greater than 84 drink caffeinated beverages. Students whose cumulative averages are from 68 –75.9 intake energy drinks daily. Conclusion: Findings indicate that a healthy lifestyle is associated with a quality of life and higher cumulative averages among college students. Students followed quality dietary habits, good sleep quality, and physical behaviors and activity. © 2025, World Scientific and Engineering Academy and Society. All rights reserved.},
	language = {English},
	journal = {WSEAS Transactions on Environment and Development},
	publisher = {World Scientific and Engineering Academy and Society},
	author = {Ahmad, W.A. and Khuzai, R. and Al Bahtiti, N.H. and Sasa, T. and Abdel-Rahman, I.},
	year = {2025},
	keywords = {Academic achievement, Academic performance, Dietary habits, Education for sustainable development, Lifestyle behaviors, Physical activit, Sleep},
	pages = {574--582},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{balakrishnan_participatory_2025,
	title = {Participatory research strategy in creating climate change awareness campaign to community: {Malaysian} undergraduates’ experiences},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006895868&doi=10.1108%2FIJSHE-09-2024-0608&partnerID=40&md5=4891bbec748593346eebea7df9165a0f},
	doi = {10.1108/IJSHE-09-2024-0608},
	abstract = {Purpose: This study concentrated on creating an awareness campaign for the community using a participatory research model that involved environmental experts, community representatives and undergraduates. This study aims to explore the impact of the undergraduates’ involvement in the awareness campaign project in the context of their environmental actions and advocacy on climate change. Design/methodology/approach: The authors developed the climate change awareness campaign for the community using the participatory research method. The authors conducted interviews with 19 undergraduates from University A, Malaysia, who directly participated in the project to understand their perspectives on environmental initiatives and advocacy following their involvement in this community-wide campaign to raise awareness about climate change. Findings: The analysis of the interview data revealed that the study participants demonstrated the appropriate knowledge, skills and values that were required concerning climate change and environmental sustainability. Three key themes that emerged were mindset toward environmental sustainability; vigor to protect the environment; and advocacy of climate change. These themes suggest that involving undergraduates in the campaign’s development and organization phases instill the correct values and intentions for advocating climate change and promoting environmental sustainability. Originality/value: The undergraduates’ implementation of participatory research in developing an awareness campaign for the community offers an innovative component to the existing education for sustainable development paradigm in higher education institutions. This approach has the potential to develop well-rounded undergraduates who are motivated to work toward environmental sustainability and are willing to advocate for climate change. © 2025, Emerald Publishing Limited.},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Balakrishnan, B. and Chua, Y.L. and Ugap, C.},
	year = {2025},
	keywords = {Climate Change, Undergraduates},
	annote = {Export Date: 25 February 2026; Cited By: 1; Correspondence Address: B. Balakrishnan; Faculty of Art, Sustainability and Creative Industry, Sultan Idris Education University, Tanjong Malim, Malaysia; email: balab@fskik.upsi.edu.my},
}

@article{chen_rethinking_2025,
	title = {Rethinking talent cultivation for carbon neutrality: a case study of higher education reform in {China}},
	issn = {14765284 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105005522044&doi=10.1080%2F14765284.2025.2506216&partnerID=40&md5=13d7846a358d2d628a04f740abd44f8a},
	doi = {10.1080/14765284.2025.2506216},
	abstract = {China’s “dual carbon” goals necessitate reforms in the higher education system to cultivate interdisciplinary talents with green development competencies. While existing literature predominantly focuses on carbon neutrality technologies, policy pathways, as well as educational investments and returns, this study centers on the driving value of talent cultivation in the dual carbon field for achieving carbon neutrality. Using Southwestern University of Finance and Economics as a case study, we construct a horizontal-vertical analytical framework integrating green economy theory, education for sustainable development theory, and regional coordinated development theory. This framework systematically examines how interdisciplinary integration, curriculum system restructuring, and university-enterprise collaboration can foster professionals aligned with the United Nations Sustainable Development Goals (SDGs).The study proposes a “Interdisciplinary Integration × Curriculum Reform × University-Enterprise Synergy” talent cultivation paradigm, offering a reference pathway for emerging economies to balance international standards with localized practices. Additionally, it highlights the need to address common challenges in global dual carbon education through interdisciplinary certification mechanisms, “hybrid-driven” university-enterprise partnerships, and localized curriculum adaptation. © 2025 The Chinese Economic Association–UK.},
	language = {English},
	journal = {Journal of Chinese Economic and Business Studies},
	publisher = {Routledge},
	author = {Chen, J. and Chen, X.},
	year = {2025},
	keywords = {Dual carbon goals, educational transformation, talent cultivation},
	annote = {Export Date: 25 February 2026; Cited By: 1; Correspondence Address: X. Chen; School of Public Administration, Southwestern University of Finance and Economics, Chengdu, Sichuan, China; email: chenxingyu\_xy@163.com},
}

@incollection{espinoza-ramos_embedding_2025,
	title = {Embedding {Sustainability} in {Curricula}: {A} {Case} {Study} of an {Education} for {Sustainable} {Development} ({ESD}) {Framework} at the {Westminster} {Business} {School}},
	volume = {Part F325},
	isbn = {21967075 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003974119&doi=10.1007%2F978-3-031-86337-0_16&partnerID=40&md5=09ac147c6f7f5f3eda832c507aa0f857},
	doi = {10.1007/978-3-031-86337-0_16},
	abstract = {Increasingly complex socio-economic and environmental issues have been transforming all industries, with education playing a critical role in shaping a sustainable future. For that reason, UNESCO created the Education for Sustainable Development (ESD), which is an interdisciplinary approach to learning that enables students to develop the values, knowledge and competencies needed to address the current local and global challenges (UNESCO, 2023). The Sustainable Development Goals (SDGs) adopted by the United Nations in 2015 provide a comprehensive framework for addressing these challenges (United Nations, n.d.). However, there are barriers to the implementation of ESD in the curricula, including a lack of detailed guidance to implement it in educational contexts (Waltner et al., 2020), resistance to change and lack of financial resources (Calvert et al., 2023). For that reason, there is a need for guidance in the implementation of ESD, in this case, in the context of higher education. This conceptual paper is aimed at providing a framework to aid educators in embedding ESD in their curricula. This framework has nine stages: alignment of ESD policy and education strategy, mapping course and module learning outcomes, pedagogy, training of module design, learning activities, assessment, indicators and feedback for improvement. This paper uses narrative inquiry (Adams, T.E., Ellis, C., Jones, S.H. in Autoethnography. In The International Encyclopedia of Communication Research Methods. pp. 1–11. Wiley (2017)) as a research strategy to analyse the module leaders’ experiences when developing the ESD framework and applying it to Sustainable City Economies (SCE), a second-year undergraduate module (340 students) at the Westminster Business School (England) that has been implemented since 2021/22. This paper showcases the positive impact of the ESD framework in different areas, including assessment performance, consistent engagement on a field trip and positive feedback during module evaluation. The early findings represent an opportunity for further research to assess the impact of the ESD framework over time and its application to other disciplines. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {{CSR}. {Sustain}. {Ethic}. {Gov}.},
	publisher = {Springer Nature},
	author = {Espinoza-Ramos, G. and Capucci-Polzin, A.},
	year = {2025},
	note = {Journal Abbreviation: CSR. Sustain. Ethic. Gov.},
	keywords = {Education for Sustainable Development, ESD framework, Pedagogy},
	pages = {279--299},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: A. Capucci-Polzin; Westminster Business School, University of Westminster, London, United Kingdom; email: a.capuccipolzin@westminster.ac.uk},
}

@incollection{arslan_nudging_2025,
	title = {Nudging as a {Tool} to {Raise} {Awareness} for {ESD} among {Distance} {Learning} {Students} {Using} the {Example} of {Learning} with {Digital} {Study} {Materials}},
	volume = {Part F280},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002810166&doi=10.1007%2F978-3-031-80434-2_39&partnerID=40&md5=11761a11041a01d48f165b94b52ee33b},
	doi = {10.1007/978-3-031-80434-2_39},
	abstract = {Education for Sustainable Development (ESD) is a fundamental component of the pursuit of the Sustainable Development Goals (SDGs). As part of ESD, it is essential to develop the competence to think and act sustainably. This competence is increasingly being integrated into higher education. Distance learners, by virtue of their professional activities, are predestined to practice and immediately apply the ESD competence they learn and to deal with future challenges. The concept of nudging can be used to develop this ESD competence. Nudging has been successfully applied in the fields of sustainable food and slow fashion. Thaler and Sunstein (Nudge: improving decisions about health, wealth, and happiness. Penguin, 2009) described the method of nudging people to make the right choices and change their behavior, e.g. to be more environmentally conscious. The purpose of this study is to identify effective nudges that promote sustainable behavior among distance learning students. The study attempts to use nudges to motivate students to abandon the use of printed learning materials and instead adopt more sustainable practices. To answer the research question, qualitative interviews were conducted following the Critical Incident Technique to investigate effective nudges to reduce the use of paper-based study materials and to increase awareness of ESD. The results showed that nudges with relevant information were most effective, with their impact influenced by demographic factors such as age and study context. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Arslan, L. and Lenz-Kesekamp, V.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {ESD, Higher education, Nudges, Sustainable behavior},
	pages = {713--728},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: V. Lenz-Kesekamp; Euro-FH–University of Applied Sciences, Hamburg, Germany; email: vera.kristina.lenz-kesekamp@euro-fh.de},
}

@incollection{birdman_connecting_2025,
	title = {Connecting {Sustainability} and {Culture}: {Building} {Competencies} {Through} {Virtual} {Exchange}},
	volume = {Part F280},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002806686&doi=10.1007%2F978-3-031-80434-2_40&partnerID=40&md5=1a182fa32584265f45ffc176267f0fd3},
	doi = {10.1007/978-3-031-80434-2_40},
	abstract = {In A/Res/70/1 (the 2030 Agenda) the UN General Assembly presents a vision of universal values for a more sustainable future, including fostering intercultural understanding and global citizenship. One traditional approach to doing so is to include international exchange programs as part of the university experience. Such exchange programs are not equally available to all students for a myriad of reasons, including economic, social, and political. Virtual exchanges, while also not universally accessible, offer more students the opportunity to create international connections within a mutual learning environment. While virtual exchanges have long been of interest for competence development in language education, the potential for education for sustainable development (ESD) has yet to be explored. We designed a class with a virtual exchange at the core, and which connects students from Leuphana University, Germany with students at Trabzon University in Türkiye. Throughout the semester, the students worked in mixed groups to investigate and write a blog on a sustainability solution of their choice as it is embedded in their respective, local communities. They collaborated virtually while learning about intercultural competence, global citizenship, and the cultural aspect of sustainability in a blended-learning environment. In this paper, we will present an argument for the usefulness of methods used in language education for sustainability competencies. We then describe the course design and delivery as well as initial exploration of student learning outcomes using the students’ reflective journals. We found that the students found the project work in mixed, virtual teams motivating and added complexity to their understanding of interpersonal competence and sustainability solutions. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Birdman, J. and Çelik, H. and Pandarova, I. and Barron, A. and Benitt, N. and Schmidt, T.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	pages = {729--747},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: J. Birdman; Leuphana University Lüneburg, Institute of English Studies, Hamburg, Germany; email: jodie.birdman@leuphana.de},
}

@incollection{cordaro_parallels_2025,
	title = {Parallels {Among} {Competencies} of {STEM} {Education} and {Education} for {Sustainability}},
	volume = {Part F280},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002772886&doi=10.1007%2F978-3-031-80434-2_51&partnerID=40&md5=94654df61803e109320583e00a990fcb},
	doi = {10.1007/978-3-031-80434-2_51},
	abstract = {Due to the current climate crisis, growing social inequities, and continued exploitation of the environment and its inhabitants, there is an urgent need to incorporate education for sustainability (EfS) into mainstream education globally (Nolet, Teachers College Record 111:409–442, 2009; Santone, Educational Leadership 61:60–63, 2003; Sterling, Environmental Education Research 16:511–528, 2010). Science, technology, engineering, and mathematics (STEM) education isa growing educational approach that appears to share some common goals and pedagogies of EfS. The authors conducted a scoping literature review to examine the parallels between STEM education and EfS competencies in K-12 education. A total of 25 articles from 2013 to 2022 were reviewed, revealing emergent themes in the data. Many competencies fell under the United Nations Educational, Scientific and Cultural Organization (UNESCO) key competencies for sustainability (UNESCO, Education for Sustainable Development Goals Learning Objectives, 2017). This review revealed that the most common competencies in both educational initiatives are systems thinking, critical thinking, and collaborative skills. The findings of this systematic review inform future research regarding how these emergent competencies can be used to enable EfS to become more mainstream in K-12 STEM education classrooms and initial teacher education (ITE) programs in higher education, which would transfer skills into STEM careers. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Cordaro, J.A. and Murphy, C.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Competencies, Education for sustainability, STEM education, Sustainability education},
	pages = {927--944},
	annote = {Export Date: 25 February 2026; Cited By: 2; Correspondence Address: J.A. Cordaro; University of Wisconsin-Stevens Point, Stevens Point, United States; email: jcord241@uwsp.edu},
}

@incollection{braithwaite_green_2025,
	title = {A {Green} {Community} for {Change}, {Through} {Sustainable} {Development} and {Entrepreneurship} in the {Fashion} {Business} {Curriculum}},
	volume = {Part F280},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002742598&doi=10.1007%2F978-3-031-80434-2_16&partnerID=40&md5=f1b9ecf8900a942515c02dac8ef51078},
	doi = {10.1007/978-3-031-80434-2_16},
	abstract = {The environmental impact of the fashion industry is well documented. Despite significant moves towards more circular approaches across the global fashion supply chain and the introduction of innovative business models, there is still some way to go for this sector to be considered truly sustainable. In line the urgency to embed education for sustainable development (ESD) within UK Higher education curriculums has also gained momentum. As academics specialising in fashion business education, we have noted an increase in student engagement around sustainable development through independent research projects. This is resulting in an increased appetite for careers with companies who are leaders in embedding more sustainable values in their business models. In response, the research that underpins this chapter had two key aims. Firstly, to identify pedagogical strategies that could better embed sustainability within fashion business courses. This resulted in a further aim which set out to develop student knowledge and skills around the area of green entrepreneurialism, with the view to better prepare them for a future in the fashion industry. The chapter presents key findings from a research question that focused on whether pedagogical innovations could positively engage students more fully in sustainable development within the realms of fashion business education. Discussion of the results of a series of curricula activities demonstrates the impacts of these approaches on the development of sustainability knowledge and employability skills for students who have the potential to become entrepreneurial gamechangers. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Braithwaite, N. and Trencher, L.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Fashion business education, Green skills, Sustainable knowledge},
	pages = {261--277},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: N. Braithwaite; Nottingham School of Art and Design, Nottingham Trent University, Nottingham, United Kingdom; email: Naomi.braithwaite02@ntu.ac.uk},
}

@incollection{ashford_major_2025,
	title = {Major {Challenges} to {Education} for {Sustainable} {Development}},
	volume = {Part F280},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002611278&doi=10.1007%2F978-3-031-80434-2_6&partnerID=40&md5=800f8a71fa90222f1d1f53a9785a377b},
	doi = {10.1007/978-3-031-80434-2_6},
	abstract = {Scholars and professionals committed to fostering sustainable development have urged a re-examination of the curriculum and restructuring of research and teaching in institutions of higher learning. This paper begins by discussing an expansive and trans-disciplinary definition of sustainable development that includes economic, environmental, and employment concerns important to both developed and developing nations. It then distinguishes inter-disciplinary, multi-disciplinary, and trans-disciplinary problem solving. Finally, the paper addresses the following themes and questions: (1) How can more multi- and trans-disciplinary research and teaching coexist in a meaningful way in today’s university structures? (2) Does education relevant to sustainable development require its own protected incubating environment to survive, or will it otherwise be gobbled up and marginalized by attempting to instill it throughout the traditional curriculum and traditional disciplines? (3) How can difficulties in linking the needed teaching and research be overcome? (4) Even if there exist technical options to do so, how can it be made safe for courageous students to take educational paths different from traditional tracks and find adequate financial support for their studies? (5) What roles can national and EU governments have in accelerating the needed changes? and (6) What can we learn from comparative analysis of universities in different nations and environments? © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Ashford, N.A.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Employment, Environment, Environmental sustainability, Multi-disciplinary, Sustainability, Sustainable development, Trans-disciplinary},
	pages = {71--82},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: N.A. Ashford; MIT Program in Technology and Law, Massachusetts Institute of Technology, Cambridge, United States; email: nashford@mit.edu},
}

@article{cattani_green_2025,
	title = {Green degrees, unequal futures? {How} sustainability in higher education curricula impacts graduate outcomes in {Italian} regions},
	volume = {50},
	issn = {03075079 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105002077714&doi=10.1080%2F03075079.2025.2485406&partnerID=40&md5=16e9e2f2c65af4480447bb0718c06e42},
	doi = {10.1080/03075079.2025.2485406},
	abstract = {This research examines the evolving landscape of academic curricula, focusing from a territorial perspective on changing graduate labour market outcomes in the wake of the introduction of the so-called ‘green curricula’ in the Italian higher education (HE) system. As the promotion of ‘green skills’ and the creation of ‘green jobs’ gain momentum in the sustainability debates at both the European and international level, we analyse how the expansion of green curricula affects local labour market outcomes for graduates and contributes to inequality. To address existing research gaps, we utilise data from the AlmaLaurea Interuniversity Consortium, the Italian Ministry of University and Research, and the Italian Labour Force Survey. We conduct a panel fixed effects analysis to assess the impact of environmentally focused HE programmes on various local labour market outcomes among graduates, also controlling for potential spatial effects. Our findings highlight the role of sustainability-oriented degrees in shaping local labour market conditions and, consequently, in influencing inequality in outcomes (which we label ‘green bias’) among graduates. By contributing to the broader discourse on unequal graduate outcomes, our research offers insights into the implications of incorporating environmental sustainability into HE programmes. Focusing on the Italian context, we provide new evidence on the potential unintended social consequences of sustainability-oriented educational policies in the context of a just transition. © 2025 Society for Research into Higher Education.},
	language = {English},
	number = {5},
	journal = {Studies in Higher Education},
	publisher = {Routledge},
	author = {Cattani, L. and Manitiu, D.N. and Pedrini, G.},
	year = {2025},
	keywords = {graduate labour markets, graduate outcomes, higher education, inequality, Sustainability},
	pages = {1005--1037},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: L. Cattani; Department of Law, Politics and International Studies, University of Parma, Parma, Italy; email: luca.cattani2@unipr.it},
}

@incollection{baughan_professional_2025,
	title = {Professional {Development} for {All}: {Enabling} {Advocates} for {Education} for {Sustainable} {Development}},
	isbn = {9781040349762 (ISBN); 9781032588032 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001907066&doi=10.4324%2F9781003451563-10&partnerID=40&md5=82f803939d2ac261ba8b7be0027f9e3f},
	doi = {10.4324/9781003451563-10},
	abstract = {If our sector is to promote and innovate in sustainability, and our aim is to develop authentic sustainable graduates through learning, teaching and the broader student experience, our staff also need to be advocates for sustainability in higher education. In this chapter, we examine professional development opportunities for Education for Sustainable Development (ESD) that might be considered for different staff in higher education, be they university leaders, researchers, educators, or in professional services roles. It is argued that sustainability is relevant to all staff, and opportunities need to be provided for all staff to learn about and contribute to sustainability within their institutions. Further, there needs to be alignment of professional development for staff, enabling them to work together in their institutions. We consider who might provide professional development, and how such professional development for ESD should work in a way that invites engagement and excitement in disciplinary contexts, as opposed to being prescriptive. We consider the possible barriers to staff development in sustainability and suggest positive ideas to negate these issues, including acknowledging disciplinary differences and working closely with students. The chapter advocates that professional development for sustainability can be an exciting and inclusive venture as opposed to another ‘add-on’ that staff are mandated to undertake. © 2025 selection and editorial matter, Rehema M. White, Simon Kemp, Elizabeth A. C. Price and James W. S. Longhurst; individual chapters, the contributors.},
	language = {English},
	booktitle = {Perspectives and {Practices} of {Education} for {Sustainable} {Development}: {A} {Critical} {Guide} for {Higher} {Education}},
	publisher = {Taylor and Francis},
	author = {Baughan, P. and Price, E.A.C. and Longhurst, J.W.S.},
	year = {2025},
	note = {Journal Abbreviation: Perspectives and Practices of Education for Sustainable Development: A Critical Guide for Higher Education},
	pages = {211--228},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{babintseva_impact_2025,
	title = {{IMPACT} {OF} {ENVIRONMENTAL} {EDUCATION} {DEVELOPMENT} {ON} {PROMOTING} {ENVIRONMENTALLY} {SAFE} {USE} {OF} {NATURAL} {RESOURCES} {AND} {CAREFUL} {ATTITUDE} {TOWARD} {NATURE}},
	volume = {15},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001641506&doi=10.31407%2Fijees15.114&partnerID=40&md5=7ab180e3532e983a5f59389cf3654d1c},
	doi = {10.31407/ijees15.114},
	abstract = {The implementation of education for sustainable development is a top priority. Environmental education serves as a tool for fostering a responsible, humane, and ethical attitude toward nature. At the current stage of human development, where environmental issues have reached a global scale, environmental education aims at transforming human consciousness and attitude toward nature. This article highlights the importance of organizing an educational process to inform children and the youth about environmental protection issues. Children and young people are the driving forces that will influence the environment in the future. The foundation for implementing an effective environmental education strategy lies in the institutional development of a three-tier system for environmental education: preschool institutions, general education schools, and higher education institutions. The effectiveness of environmental education can be achieved through the maximum integration of formal and informal environmental education efforts. © 2025, Hysen MANKOLLI. All rights reserved.},
