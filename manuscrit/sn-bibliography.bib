	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Balakrishnan, B. and Fedorova, N. and Ugap, C.},
	year = {2025},
	keywords = {Creativity, Design, Education for sustainable development, Sustainability, Undergraduates},
	pages = {101--118},
	annote = {Export Date: 25 February 2026; Cited By: 2; Correspondence Address: B. Balakrishnan; Sultan Idris Education University, Tanjong Malim, Malaysia; email: balab@fskik.upsi.edu.my},
