@article{ferrari_who_2025,
	title = {Who is taking climate action in university? {Drivers} of personal and professional climate action in higher education},
	volume = {26},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001080878&doi=10.1108%2FIJSHE-08-2023-0392&partnerID=40&md5=a55684c5b8a4e2f3b6214fac6012f79e},
	doi = {10.1108/IJSHE-08-2023-0392},
	abstract = {Purpose: Climate change (CC) poses significant risks to society, but there are ways people can address it – including in their personal and professional lives. One professional context – higher education – has a unique role in tackling CC through educating future leaders and researching potential solutions. This study aims to identify the predictors that determine climate action in the university. Design/methodology/approach: The predictors of climate action (including both personal behaviour change and academic subject choice) are examined amongst both university students and staff at a UK university. The authors present the results of an online survey (N = 3,326). Findings: Climate education and research were associated with early and mid-career researchers, years working/studying and academic field, with engineering staff/students most involved. Climate anxiety and awareness of university climate emergency declarations and credible climate information sources significantly explain academic behaviour among students and academics. In addition, activities with substantial carbon footprints, such as driving and eating ruminant meat, could be associated with CC research and teaching. Originality/value: These results highlight the importance of improving climate literacy, and sustainability initiatives within higher education. To address the urgent issues of CC, higher education institutions must integrate climate education, research and sustainable practices. © 2025, Enzo Ferrari, Lorraine Whitmarsh, Paul Haggar, Kaloyan Mitev and Alice Lowe.},
	language = {English},
	number = {9},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Ferrari, E. and Whitmarsh, L. and Haggar, P. and Mitev, K. and Lowe, A.},
	year = {2025},
	keywords = {Climate action, Climate anxiety, Climate change, Higher education, University research},
	pages = {18--35},
	annote = {Export Date: 25 February 2026; Cited By: 3; Correspondence Address: E. Ferrari; EMC3 Research Group and Department of Math and Science Education, Universidad de Salamanca, Salamanca, Spain; email: enzoferrari@usal.es},
}

@incollection{boman_different_2025,
	title = {Different {Ways} to {Develop} {Sustainability} {Competences}—{Experiences} from the {University} of {Gothenburg}},
	volume = {Part F128},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000441569&doi=10.1007%2F978-3-031-80380-2_8&partnerID=40&md5=3fdbc3968b0a6cb5add34d037250d358},
	doi = {10.1007/978-3-031-80380-2_8},
	abstract = {One of the three commitments in the Vision 2030 of the University of Gothenburg, Sweden, is to work for a sustainable and knowledge-based societal development: “The University will step up its contribution towards the sustainable-development goals articulated by the United Nations’ General Assembly in Agenda 2030.” One way to address this is through competence development. In this chapter, examples of how to address sustainability competences for staff and for students will be presented and discussed. The examples include: (i) labelling of curricula for courses and program plans, (ii) building pathways to enhance education for sustainable development (ESD), based on quality, competence, and relevance and building on mapping of learning outcomes to a set of sustainability criteria or to the UN global sustainable development goals. (iii) The third example is based on a baseline study on education for sustainable development while a (iv) fourth example concerns a recurring series of open forums on sustainable development. Addressing the complexity of education for sustainable development through multiple approaches has proven successful in engaging more people, helping the university in fulfilling its Vision 2030 commitments to sustainable societal development. In conclusion, using a set of different approaches for the inclusion of sustainability in education and for the development of competences has proven to be a successful way forward. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Boman, J. and Omrcen, E. and Weldemariam, K.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Education for sustainable development, Educators’ competences, ESD, Forums, Labelling, Mapping},
	pages = {153--171},
	annote = {Export Date: 25 February 2026; Cited By: 1; Correspondence Address: J. Boman; University of Gothenburg, Unit for Property and Sustainable Development, Section for Sustainability, Gothenburg, P.O.Box 100, 405 30, Sweden; email: Johan.boman@gu.se},
}

@incollection{ekimova_green_2025,
