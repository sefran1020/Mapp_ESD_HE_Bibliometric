	keywords = {Curricular sustainability, Education for sustainability, Higher education, Sustainability literacy, Teaching methodologies, Teaching practice},
	pages = {1021--1041},
	annote = {Export Date: 25 February 2026; Cited By: 11; Correspondence Address: A. Coronado-Marín; International Doctoral School, National University of Distance Education, UNED, Madrid, Bravo Murillo St. Nº14, 28040, Spain; email: acoronado@edu.uned.es},
}

