@article{ata_genai_2025,
	title = {{GenAI} image creation in {EFL}: prompt writing as an emerging writing activity for sustainability-focused artivism},
	issn = {17501229 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021936786&doi=10.1080%2F17501229.2025.2587248&partnerID=40&md5=d580315c59a09953481216aa45e46d57},
	doi = {10.1080/17501229.2025.2587248},
	abstract = {Purpose: This study examines an intervention whose primary aim is to advance sustainability awareness (issues framed by the UN’s Sustainable Development Goals) through artivism-oriented language practice tasks (art aimed at social or environmental action), and whose secondary aim is to offer purposeful English prompt-writing practice with near-immediate feedback in the form of generated images. Methodology: A qualitative descriptive study was conducted at a university in Northern Cyprus. Twenty-one preparatory-year students attended two workshops: one on sustainability and artivism, the other on prompt writing for AI image generation. Participants created 84 Generative Artificial Intelligence (GenAI) images on self-selected sustainability themes for a public World Environment Day exhibition. Data comprised participants’ written prompts, descriptive texts, researchers’ field notes, and semi-structured interviews with 15 participants who completed the whole cycle. All sources were subjected to a thematic analysis. Findings: Learners described iterative prompt-writing practice as requiring precise wording (e.g. lexical choice, prepositions, clause structure) and reported increased confidence in writing. Artivist image generation triggered a strong cognitive-emotional reaction toward glocal sustainability challenges. Collaboration, peer revising of English phrasing, and joint troubleshooting of AI outputs emerged as pivotal mediators. Participants described these practices as transferable to future language use. Originality: This empirical study systematically investigates prompt-writing-driven GenAI artivism in an EFL setting, documenting enhanced sustainability awareness and reported gains in writing confidence and strategy use. It offers a replicable workshop-plus-exhibition model that integrates GenAI into language practice within Education for Sustainable Development. © 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
	language = {English},
	journal = {Innovation in Language Learning and Teaching},
	publisher = {Routledge},
	author = {Ata, M. and Kunt, N.},
	year = {2025},
	keywords = {artivism, Generative artificial intelligence, human-computer co-creativity, language education for sustainable development, prompt writing},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: M. Ata; Department of Foreign Language Teaching, Eastern Mediterranean University, Famagusta, Cyprus; email: muratata@gmail.com},
}

@article{carstensen_mapping_2025,
	title = {Mapping {Green} {Skills} in {Collective} {Skill} {Formation} {Systems}: {A} {Natural} {Language} {Processing} {Analysis} of {Danish} {Vocational} {Education} and {Training}},
	issn = {17485983 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021101352&doi=10.1111%2Frego.70097&partnerID=40&md5=2d7dfeb2adedc2a222613358a3875a52},
	doi = {10.1111/rego.70097},
	abstract = {Vocational education plays a vital role in fostering green skills that are central for achieving climate goals, sustaining economic competitiveness, and promoting social inclusion. Expectations are especially high for collective vocational education systems, in which both employers and the state are deeply involved in governance and funding. However, little is known about the extent to which collective systems have adapted to the skill demands of a green economy. Using Denmark as a case, this paper examines how collective vocational systems adjust skill content to support a net-zero carbon economy. Using natural language processing, we analyze the integration of green skills in the training ordinances of 101 Danish vocational programs from 2015 to 2024. Rather than a uniform transition, this explorative study identifies diverse trajectories of skill adaptation. Based on the analysis, four reform trajectories are inductively identified: trailblazers, that rapidly integrate green skills; adaptors, that make substantial but incremental changes; laggards, that make limited updates; and late bloomers, that initially delay reforms but later accelerate green skill integration. © 2025 John Wiley \& Sons Australia, Ltd.},
	language = {English},
	journal = {Regulation and Governance},
	publisher = {John Wiley and Sons Inc},
	author = {Carstensen, M.B. and Ibsen, C.L. and Jensen, I.M.N. and Lund-Sørensen, B.},
	year = {2025},
	keywords = {green skills, green transition, natural language processing, political economy, vocational education},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: M.B. Carstensen; Roskilde University, Roskilde, Denmark; email: mcar@ruc.dk},
}

@article{farrell_using_2025,
	title = {Using eco-social justice to develop a continuous professional development workshop exploring how education for sustainable development can be embedded into early childhood education and social care courses in {South} {East} {Technological} {University}, {Ireland}},
	volume = {14},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021065160&doi=10.14324%2F111.444.ijsp.2025.v14.x.011&partnerID=40&md5=398cfcad2bff0f7c71ad2c3576df2f8a},
	doi = {10.14324/111.444.ijsp.2025.v14.x.011},
	abstract = {Social pedagogy is grounded in the belief that education can drive meaningful and lasting change in society. Traditionally focused on human relationships and mutual care, social pedagogy is now being extended to include our relationship with the planet and its ecosystems. Eco-social justice highlights the dangers of prioritising economic growth at the expense of human rights and environmental sustainability as it leads toecological degradation and deepening economic inequalities. We propose eco-social justice as a lens through which climate change, and its broader social impacts, can be understood as a pressing issue for early childhood education and social care work in Ireland. Our initiative responds to the urgent need to reframe the climate crisis beyond an environmental concern to a social justice concern. Increasingly, educators are expected to help students connect global challenges, such as sustainability, inequality and justice, with their future professional roles. This article outlines the conceptual foundation for a continuous professional development workshop developed for academics in early childhood education and social care at South East Technological University. The workshop offered participants a space to reflect on their existing knowledge, attitudes and practices related to eco-social justice and education for sustainable development. It encouraged dialogue around how these themes are currently integrated into course content and their enhanced embeddedness. The workshop was analysed as part of a Master of Arts in Teaching and Leaning, and because of ethical and academic constraints, participant insights cannot be shared at this time. © 2025, Eileen Farrell and Lillian Byrne.},
	language = {English},
	number = {1},
	journal = {International Journal of Social Pedagogy},
	publisher = {UCL Press},
	author = {Farrell, E. and Byrne, L.},
	year = {2025},
	keywords = {continuing professional development, early childhood education, eco-social justice, education for sustainable development, planetary citizenship, social care work, social pedagogy},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@incollection{de_universities_2025,
	title = {Universities and the {Development} of {Sustainable} {Cities}: {A} {Descriptive} {Study} of {University} {Outreach} {Projects} of the {HEIs} {Within} the Ânima {Ecosystem} {Aligned} with {SDG} 11},
	volume = {Part F1079},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020478062&doi=10.1007%2F978-3-031-96251-6_28&partnerID=40&md5=a7b33827eaa8383373a242683d0c0b53},
	doi = {10.1007/978-3-031-96251-6_28},
	abstract = {This chapter explores how Higher Education Institutions (HEIs) belonging to the Ânima Education Ecosystem promote education for sustainable development (ESD) through university outreach, supporting the construction of sustainable cities, with a focus on Sustainable Development Goal (SDG) 11. Faced the increasing urbanization and the imperative need for sustainability, HEIs emerge as catalysts in promoting outreach projects aligned with the SDGs and their targets. This chapter, produced through a literature review and the collection of data derived from documents and outreach projects of the studied HEIs, seeks to answer the following question: How do the university outreach projects promoted by the HEIs of the Ânima Ecosystem contribute to the implementation of SDG 11 and its targets, aiming to make cities sustainable? Through the analysis of the selected texts and the collected data, it was possible to perceive that university outreach integrates professors, technicians, and students into the reality outside the university walls, allowing for the exchange of knowledge between the university and society, which can result in positive changes for society, with the potential to drive sustainable cities. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {De, S.B. and Maccari, K.M. and de Costa, M. and Dutra, A.R. and Guerra, J.B.S.O.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Education for sustainable development (ESD), Higher education institutions, SDG 11, Sustainable cities, University outreach},
	pages = {465--484},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: S.B. de S. Thiago; Graduate Program in Business Administration, University of Southern Santa Catarina (UNISUL), Tubarao, Brazil; email: olange.thiago@animaeducacao.com.br},
}

@incollection{berchin_enhancing_2025,
	title = {Enhancing {Veterinary} {Education} for {Sustainable} {Development}: {Evaluating} {Awareness} and {Integrating} {One} {Health} in {Higher} {Education}},
	volume = {Part F1079},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105020473707&doi=10.1007%2F978-3-031-96251-6_27&partnerID=40&md5=55728b2260fae762568b0840696c588d},
	doi = {10.1007/978-3-031-96251-6_27},
	abstract = {The global increase in pet populations, driven by sociocultural changes that integrate pets as family members, presents new challenges for public health. The growth of urban areas combined with rising pet ownership intensifies pressures on the One Health framework, which emphasizes the interconnectedness of environmental, animal, and human health. This paper evaluates the level of awareness among veterinarians regarding Sustainable Development and the One Health approach, while also exploring the role of higher education in enhancing veterinary professionals’ contributions to a sustainable and resilient society. The study was conducted with faculty members from a prominent veterinary higher education institution in Brazil. The findings suggest that although veterinarians are aware of the One Health concept, their familiarity with Sustainable Development and their significance for promoting a sustainable society is limited. Given that veterinary practitioners are uniquely positioned to address One Health challenges, the study recommends that veterinary curricula be expanded to include education on sustainable development. Future research should explore the nexus between health, food, water, and energy security to better inform strategies that promote sustainable development and societal resilience. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Berchin, I.I. and Pereira Ribeiro, J.M.P. and Guerra, J.B.S.O.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Higher education, One health, Sustainable development, Veterinary education},
	pages = {449--463},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: I.I. Berchin; Centre for Sustainable Development/Research Group on Energy Efficiency and Sustainability (GREENS), University of Southern Santa Catarina (UNISUL), Florianopolis, Brazil; email: issa.berchin@gmail.com},
}

@book{galloway_transforming_2025,
	series = {Transforming {Education} for {Sustainable} {Development}: {Global} {Perspectives} from {Classroom} to {Practice}},
	title = {Transforming {Education} for {Sustainable} {Development}: {Global} {Perspectives} from {Classroom} to {Practice}},
	isbn = {9781040403549 (ISBN); 9781032492292 (ISBN)},
