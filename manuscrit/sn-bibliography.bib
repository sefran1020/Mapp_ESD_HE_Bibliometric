@article{dixit_building_2025,
	title = {Building green skills through knowledge sharing and social capital: an {HRD} study of {Kenyan} {SMEs}},
	issn = {13678868 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019713768&doi=10.1080%2F13678868.2025.2575504&partnerID=40&md5=7c9a2776f78c5479eba3bbbe1601005a},
	doi = {10.1080/13678868.2025.2575504},
	abstract = {This study examines how informal human resource development (HRD) processes, specifically knowledge acquisition and knowledge sharing, combine with social capital to build the green-skill base that drives sustainable innovation capability (SIC) and performance in small and medium-sized enterprises (SMEs) in sub-Saharan Africa. Drawing on dynamic capabilities and learning-organisation theory, we surveyed 259 Kenyan manufacturing and service SMEs and analysed the data using partial least squares structural equation modelling. Results indicate that both knowledge acquisition and knowledge sharing are positively associated with SIC, and that cognitive social capital–capturing a shared learning culture–strengthens these relationships. Furthermore, SIC fully mediates the links between the HRD processes and firm performance, underscoring the centrality of green skills in translating learning investments into economic returns. Relational social capital showed no significant effect, suggesting that informal Kenyan networks may prioritise bonding over capability transfer. The study advances inclusive HRD scholarship by reframing sustainability outcomes as products of everyday learning practices and by foregrounding locally grounded social networks in African SMEs. Practical implications recommend peer-learning circles, micro-mentoring, and collaboration with technical and vocational education providers to co-create short green-skills programmes tailored to SME contexts. Limitations and future research directions are discussed, including qualitative inquiry and longitudinal performance tracking. © 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
	language = {English},
	journal = {Human Resource Development International},
	publisher = {Routledge},
	author = {Dixit, K. and Jarrar, H. and Salloum, C.},
	year = {2025},
	keywords = {Capacity-building, green skills, SME learning, sustainable innovation},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: C. Salloum; Métis Lab, EM Normandie Business School, Le Havre, France; email: csalloum@em-normandie.fr},
}

@article{chen_demographic_2025,
	title = {Demographic analysis of education for sustainable development among higher education institution students in {China}},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018723584&doi=10.1108%2FIJSHE-01-2025-0054&partnerID=40&md5=c52ec3f9c1c28c60293d669bb7c0b8ba},
	doi = {10.1108/IJSHE-01-2025-0054},
	abstract = {Purpose – The purpose of this study is to examine the impact of demographic factors on Education for Sustainable Development (ESD), and the diverse perspectives held by students at different higher education institutions (HEIs) in China. This study aims to advance ESD and contribute to achieving the 2030 Sustainable Development Goals with five years remaining. Design/methodology/approach – This study examines 706 students from five HEIs using a convergent mixed-methods approach. A Likert scale assessed ESD levels and demographics, with t-tests and ANOVA analysing demographic influences. Thematic analysis of open-ended responses explored students’ ESD perspectives. Findings – HEI students in China show high awareness of ESD. Significant differences were found based on age, gender, institution, academic level, major and GPA, whereas education level and residence showed no impact. A gap remains between ESD awareness and actual behaviour. Research limitations/implications – Future research should explore more demographic variables, include diverse education levels and expand globally. Multi-source questionnaires are recommended for greater depth and comprehensiveness. Practical implications – The study highlights the need to bridge the awareness–behaviour gap through experiential learning, curriculum integration, faculty training and supportive policies. Originality/value – This study is the first to explore the impact of demographics on HEI students’ ESD perspectives in China, using qualitative questions to enrich quantitative findings. © 2025 Emerald Publishing Limited},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Chen, D. and Prabowo, T.T. and Poungsuk, P.},
	year = {2025},
	keywords = {China, Demographic, Education for sustainable development, Higher education institutions, Sustainable Development Goals},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: D. Chen; School of Industrial Education and Technology, King Mongkut’s Institute of Technology Ladkrabang, Bangkok, Thailand; email: 66036001@kmitl.ac.th},
}

@article{boman_building_2025,
	title = {Building learning pathways to enhance education for sustainable development ({ESD}), quality and relevance},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105016851021&doi=10.1108%2FIJSHE-10-2024-0764&partnerID=40&md5=14f6713cfcfa82a9d17dd97bf1d91d1b},
	doi = {10.1108/IJSHE-10-2024-0764},
	abstract = {Purpose – This study aims to demonstrate how integrating sustainable development into courses and degree programs can be systematically enhanced using a transparent method that ensures high quality and relevance. By presenting findings from the University of Gothenburg, Sweden, this study addresses challenges in advancing education for sustainable development (ESD) at higher education institutions. Design/methodology/approach – This study used action research methodology which is characterized as a reflective and collaborative inquiry. A new mapping tool was used to make sustainable development more visible in the program plans. The tool maps the learning outcomes to a set of sustainability criteria or to the UN sustainable development goals. Findings – One important finding was the identification of different “sustainability tracks,” divided into “weak” or “strong” sustainability. A second finding was that processes and practices that support the integration of sustainable development in education were identified and correlated by both quantitative and qualitative analyses. Finally, three important areas to increase integration of sustainability were identified: understanding ESD in higher education; actors, stakeholders, processes and practices; tools and labelling. Research limitations/implications – This study analyzed only six degree programs, which may restrict the generalizability of the findings across the entire university curriculum or to other institutions. Originality/value – This study uniquely connects sustainable development in higher education to systematic labelling of sustainability within degree programs, enhancing transparency, coherence and student engagement. The labelling framework supports curriculum development, promotes institutional growth and ensures traceability, fostering the integration and progression of sustainability competences across courses and programs. © Johan Boman, Eddi Omrcen, Kassahun Weldemariam, Andreas Hanning and Johan Lodin. Published by Emerald Publishing Limited. This article is published under the Creative Commons Attribution (CC BY 4.0) licence. Anyone may reproduce, distribute, translate and create derivative works of this article (for both commercial and non-commercial purposes), subject to full attribution to the original publication and authors. The full terms of this licence may be seen at http://creativecommons.org/licences/by/4.0/},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Boman, J. and Omrcen, E. and Weldemariam, K. and Hanning, A. and Lodin, J.},
	year = {2025},
	keywords = {Education, Engagement, Higher education, Labelling, Mapping, Sustainability},
	annote = {Export Date: 25 February 2026; Cited By: 3; Correspondence Address: J. Boman; Unit for Property and Sustainable Development, Section for Sustainability, University of Gothenburg, Gothenburg, Sweden; email: johan.boman@gu.se},
}

@incollection{demeshkant_how_2025,
	title = {How to {Be} a {Change} {Agent} at {Schools}? {Development} and {Implementation} of a {Virtual} {Course} for {Pre}-service {Teachers}’ {Sustainability} {Education}},
	volume = {Part F819},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014461234&doi=10.1007%2F978-3-031-86985-3_10&partnerID=40&md5=6d4d0f228b2b331b5a2abbe618cda48e},
	doi = {10.1007/978-3-031-86985-3_10},
	abstract = {Environmental impact and climate change do not recognize national borders. Therefore, collaborating with international partners in this field is paramount. In the twenty-first century, universities have a crucial role in combining teaching and research not only with the transfer of knowledge but also with the renewal of the society. From this perspective, we consider pre-service teachers as agents of positive change. In this article, we present the development and implementation of a virtual and inclusive course for Pre-Service Teachers’ Sustainability Education. In cooperation with five universities across Germany, the Netherlands, and Poland, an online course curriculum was developed to enhance pre-service teachers’ sustainability competences, with a focus on education for sustainable development, globalization, and world citizenship. The course is structured around three key modules: (1) Introduction to the sustainable development issues, (2) World Citizenship, and (3) Globalization. The content of each module was developed and delivered by lecturers from each partner’s university. The paper reports preliminary findings on the aims and expectations following the practical testing of the course with students. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Demeshkant, N. and Hoppe, T. and Lude, A. and Bodenbender, V.R. and Potyrala, K. and van Oorsouw, K.-J.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Education for sustainable development, Future teachers’ ESD competencies, International virtual ESD course},
	pages = {147--159},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: N. Demeshkant; Institute of Pedagogy, University of the National Education Commission, Krakow, Poland; email: nataliia.demeshkant@uken.krakow.pl},
}

@incollection{gabaudan_sowing_2025,
	title = {Sowing {Seeds} of {Change}: {Cultivating} {Sustainability} {Literacy} in {TU} {Dublin}’s {Language} {Studies} {Curriculum}},
	volume = {Part F819},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014459297&doi=10.1007%2F978-3-031-86985-3_16&partnerID=40&md5=f3199097a65263e90037e0e96eb0e73b},
	doi = {10.1007/978-3-031-86985-3_16},
	abstract = {Embedding sustainability literacy into the Higher Education curricula is imperative particularly considering the sobering findings of the 2023 SDG Progress Report (https://unstats.un.org/sdgs/report/2023/) which indicate that only 12\% of the Sustainable Development Goal (SDG) targets are on track. Resulting from a collaboration between the Language Studies department at TU Dublin and UNITAR (United Nations Institute of Training and Research), this paper presents the fruit of a professional development (PD) initiative aimed at equipping Language Studies colleagues with practical strategies to integrate Education for Sustainable Development into their pedagogical practices. Recognizing the pivotal role of educators, as articulated by (Tribello et al. in Ir J Acad Pract 11(2), Article 6, 2024), the chapter details the stages of a PD process undertaken to empower and motivate lecturers to incorporate SDGs into their modules. The PD process started with an online roundtable discussion focusing on enhancing language lecturers’ sustainability literacy specifically in the context of language learning and teaching. The roundtable discussion was followed by a webinar that delved into TU Dublin’s Sustainability Education Framework. Finally, a day-long workshop facilitated by UNITAR on the topic of ESD for Language Studies further emphasised key cross-cutting areas of knowledge and competencies essential for fostering meaningful learning around UN’s Agenda 2030 and the SDGs. The workshop, supported by self and group-led processes yielded valuable insights, equipping Language Studies lecturers with the knowledge and skills to integrate SDGs at programmatic and modular levels, aligning with TU Dublin’s Strategic Intent 2030. This chapter contributes to providing educators and managers with strategies for embedding sustainability principles within the curriculum of Higher Education institutions. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Gabaudan, O. and Taracena, P.M. and Severino, A.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Education for sustainable development, Language studies, Languages, Sustainability literacy},
	pages = {245--263},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: P.M. Taracena; Language Studies, TU Dublin, Dublin, Ireland; email: pilar.molina@tudublin.ie},
}

@incollection{asvanyi_sustainable_2025,
	title = {Sustainable {Development} in {Higher} {Education}: {A} {Review} of {Effective} {Pedagogical} {Tools}},
	volume = {Part F819},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014428509&doi=10.1007%2F978-3-031-86985-3_24&partnerID=40&md5=a7defc0cc5360448c7f2ccae28b0a6ef},
	doi = {10.1007/978-3-031-86985-3_24},
	abstract = {In the twenty-first century, global society faces significant social and environmental challenges, highlighting the necessity of integrating education for sustainable development (ESD) within university curricula. Higher education institutions are crucial in cultivating environmentally and socially responsible individuals, aligning with Sustainable Development Goal (SDG) 4.7. The paper seeks to systematically review pedagogical tools used in higher education to teach sustainable development, aiming to increase students’ sustainability awareness. Through analyzing over 300 articles, pedagogical tools were based on effectiveness in students’ engagement, levels of digitalization, and real-world applicability. By developing a structured framework, it guides university professors in selecting tools to foster sustainable development education, supporting educators in creating curricula that promote both foundational knowledge and real-world application. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
