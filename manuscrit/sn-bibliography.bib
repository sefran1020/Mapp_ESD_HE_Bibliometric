@article{el_ouali_beyond_2025,
	title = {Beyond cognitive learning, toward transformation in higher education: lessons from {Climate} {Fresk} in sustainability education},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105027477390&doi=10.1108%2FIJSHE-05-2025-0443&partnerID=40&md5=bd0784b4c4da777d3837418630883e5c},
	doi = {10.1108/IJSHE-05-2025-0443},
	abstract = {Purpose – This study aims to examine the pedagogical impact of a participatory, systems-oriented climate workshop implemented in a French undergraduate curriculum. It explores how emotionally charged, experientially grounded activities can foster deep learning in the context of education for sustainable development (ESD), and how they shape students’ emotional responses and intention to adopt sustainable behaviors. Design/methodology/approach – Using a qualitative design, this study analyzes 70 student reflection journals collected following a Climate Fresk workshop integrated into an undergraduate course. Thematic analysis was conducted using an inductive coding strategy, guided by transformative learning theory and affective-emotional frameworks. Findings – Students reported experiencing emotional dissonance (e.g. shock, anxiety, guilt), which prompted critical reflection on ecological responsibility and personal positioning. These emotional and cognitive shifts supported a heightened sense of agency, intention and relational awareness, core elements of transformative sustainability learning. Originality/value – To the best of the authors’ knowledge, this study provides one of the first in-depth empirical analyses of Cimate Fresk in higher education, examining its role in fostering transformative learning through emotional, cognitive and relational engagement. It advances scholarship by mapping emotional transitions as integral to systems thinking and action-oriented sustainability learning. The findings challenge the limitations of knowledge-based ESD models, affirming the critical role of affective and social dynamics in shaping ecological subjectivities. By exploring how emotional engagement enables deeper learning and agency, this research offers actionable insights for educators and institutions seeking to design emotionally literate, structurally aware and collectively empowering sustainability interventions. © 2025 Emerald Publishing Limited},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {El Ouali, S. and Kakar, Q.},
	year = {2025},
	keywords = {Climate Fresk, Climate pedagogy, Education for sustainable development (ESD), Emotional engagement, Student agency, Systemic thinking, Transformative learning},
	pages = {1--21},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: Q. Kakar; ERUDITE, Université Gustave Eiffel (UGE), Paris, France; email: qkakar@escp.eu},
}

@incollection{elkholy_interchangeable_2025,
	title = {Interchangeable {Roles} in {Future} {Learning}: {Testing} {Support} {Structures} in a {New} {Triadic} {Educational} {Model}},
	volume = {Part F4986},
	isbn = {21964963 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105026575812&doi=10.1007%2F978-981-95-5234-4_18&partnerID=40&md5=7549ad44ced660a17a7bb88209d73e32},
	doi = {10.1007/978-981-95-5234-4_18},
	abstract = {This paper explores the development of a triadic educational model that incorporates “Support Structures” as a third component, alongside the traditional two-way teacher-learner interaction, to reimagine learning in higher education institutions (HEIs). Anchored in constructivist theories, the model emphasizes the interchangeability of roles between learners, facilitators, and support structures, fostering dynamic and multidirectional learning environments. The research investigates how this model aligns with future megatrends—social, environmental, and economic-technological—that shape education policy and practice. The study draws on outcomes from a workshop with HEI stakeholders and a student-led activity at the American University in Cairo. Participants co-designed future learning scenarios, exploring the application of support structures within curricula and learning spaces. Thematic analysis identified four key categories of support structures: technology (e.g., AI, VR/AR tools), spaces (e.g., flexible learning environments), community engagement (e.g., partnerships with local and global stakeholders), and governance (e.g., policies, and administrative support). Findings suggest that support structures enhance adaptability, inclusivity, and sustainability in education, enabling hyperflexibility and role interchangeability within the triadic model. The proposed framework highlights the critical role of technology, collaborative spaces, and community partnerships in advancing Education for Sustainable Development (ESD). This research contributes to the theoretical and practical understanding of future-oriented educational design, offering recommendations for tailoring the model to diverse contexts and encouraging further exploration of its potential across varied learning scenarios. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2025.},
	language = {English},
	booktitle = {Lect. {Notes} {Educ}. {Technol}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {Elkholy, A. and Gabriel, R. and Sedrak, M. and EL-Deghaidy, H. and Goubran, S.},
	year = {2025},
	note = {Journal Abbreviation: Lect. Notes Educ. Technol.},
	keywords = {Education for Sustainable Development, Future Learning, Higher Education, Hyperflexible Model of Learning, Learning Spaces},
	pages = {183--190},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: A. Elkholy; The American University in Cairo (AUC), Cairo, 11835, Egypt; email: aya.elkholy@aucegypt.edu},
}

@article{bergamini_enhancing_2025,
	title = {Enhancing urban sustainability in higher education in {Chile}: insights from active learning from online and in-class formats},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105025407553&doi=10.1108%2FIJSHE-07-2024-0467&partnerID=40&md5=7833d9fd51f470dc74853d783f07e9a7},
	doi = {10.1108/IJSHE-07-2024-0467},
	abstract = {Purpose – This study aims to research the impact of online and in-class learning formats on students’ engagement and comprehension of urban sustainability (US) in a course offered at Pontificia Universidad Católica de Chile from 2015 to 2020. Design/methodology/approach – Employing a qualitative approach, we analyzed survey responses from 238 former students, focusing on their perceptions of the US and the effectiveness of various active learning activities. Findings – Results indicate a strong preference for in-class over online learning, attributing greater learning efficacy to the former. However, active learning strategies, particularly field trips, lectures and group work, were identified as highly effective in both formats. Also, integrating the US into general university curricula as a cross-curricular discipline suggests that faculty training in digital pedagogical tools could enhance the effectiveness of online learning. Notably, student characteristics such as age, gender and professional background influenced attitudes toward technology-enhanced education. Research limitations/implications – These insights are tempered by its focus on a specific, upper-middle-class student population, suggesting the need for further research across diverse educational contexts in Latin America. Originality/value – This research underscores the critical role of active learning and calls for broader curricular integration to equip students with essential competencies for addressing sustainability challenges. © 2025 Emerald Publishing Limited},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Bergamini, K. and Ojeda, C.G. and Gutiérrez Zamorano, P. and Medina, J.I. and Araya, M.J. and Vicuña, M. and Moris, R.},
	year = {2025},
	keywords = {Active learning, Chilean social uprising, COVID-19 pandemic, Education for sustainable development, Electronic learning, Higher education, Urban sustainability},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@inproceedings{bartolome-quevedo_evaluating_2025,
	title = {Evaluating the {Effectiveness} of {Interactive} {Learning} through {Simulation} {Games} for {Climate} {Action} and {Energy} {Transition}},
	isbn = {2327185X (ISSN); 9781509007516 (ISBN); 9781665461337 (ISBN); 9781479959792 (ISBN); 9781728166469 (ISBN); 9781538643853 (ISBN); 9798331543846 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024944043&doi=10.1109%2FCiSt65886.2025.11224234&partnerID=40&md5=2a1a608752997cd3679243ebb9ccfd5d},
	doi = {10.1109/CiSt65886.2025.11224234},
	abstract = {Climate action requires society to develop new skills to address contemporary socio-ecological challenges. These skills can be effectively fostered through gamification, which promotes motivation, engagement, and shifts from passive learning to interactive and participatory education. This study explores the role of gamification in Education for Sustainable Development (ESD) through Global Sustainability CrossRoads, a game that enables players to interactively examine global sustainability policies and their environmental, economic, and social impacts. A pilot experience was conducted in a university course, employing pre- and post-intervention surveys to assess cognitive and affective learning outcomes aligned with Sustainable Development Goal (SDG) 13 and 7 of UNESCO's 2030 program. A conceptual model of game-based learning was developed, identifying three key constructs - learning predisposition, cognitive learning, and affective learning - linked through ten hypotheses tested via statistical analysis of survey data. Findings suggest that gamification significantly enhances students' understanding of climate change long-term effects and mitigation strategies, including renewable energy solutions. A notable shift in students' perceptions of climate change was observed, reflecting both increased knowledge and changes in optimism. Moreover, a strong correlation was found between students' initial perception of climate change importance and their subsequent cognitive learning gains, highlighting the role of predisposition to learn in the effectiveness of game-based education. © 2025 IEEE.},
	language = {English},
	booktitle = {Colloq. {Inform}. {Sci}. {Technol}., {CIST}},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	author = {Bartolomé-Quevedo, L. and Campos-Rodríguez, J.M. and de Blas, I. and Calleja-Duque, M. and Álvarez-Antelo, D. and Parrado-Hernando, G.},
	year = {2025},
	note = {Journal Abbreviation: Colloq. Inform. Sci. Technol., CIST},
	keywords = {Affective learning, Climate action, Climate change, Cognitive learning, Curricula, Ecology, Education computing, Education for sustainable development, Energy transition, Energy transitions, ESD, Gamification, Global sustainability, Interactive learning, Learning systems, Simulation game, Simulation games, Socio-ecological, Students, Sustainable development},
	pages = {366--371},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: L. Bartolomé-Quevedo; Group of Energy, Economy, and System Dynamics, University of Valladolid, Valladolid, Spain; email: laura.bartolome@uva.es; Conference name: 8th IEEE International Congress on Information Science and Technology, CiSt 2025; Conference location: Marrakech; Conference date: 2025-10-04 through 2025-10-10; Conference sponsors: IEEE Morocco Computer and Communication Joint Chapter; IEEE Morocco Education Chapter; IEEE Morocco Section},
}

@article{adebo_spatial_2025,
	title = {Spatial examination of sustainability literacy: the interplay of campus greenness and students’ values},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024689535&doi=10.1108%2FIJSHE-04-2025-0366&partnerID=40&md5=5c957e8bb75ca676f6dc80edb2655dce},
	doi = {10.1108/IJSHE-04-2025-0366},
	abstract = {Purpose – Evidence from the sustainability literature suggests that personal values play a significant role in environmental behaviour. However, research on how the university environment can facilitate the translation of these values into enduring knowledge of sustainability through campus greenness is limited. This study aims to examine the role of self-transcendence and conservation values in determining the sustainability literacy of university students, with the perception of campus greenness serving as a mediator. Design/methodology/approach – This study applies the theory of basic human values and social cognitive theory as a foundation for conducting correlational research among university students. A sample of 295 participants was selected using multistage sampling, and a self-report questionnaire was used to obtain responses. Partial least squares structural equation modelling validated the sustainability literacy model. Findings – Results suggest that universalism had a strong positive effect on sustainability literacy (β = 0.262, p {\textless} 0.001), benevolence also contributed positively (β = 0.155, p = 0.001), while conformity was negatively associated (β = −0.194, p = 0.005). Security showed a positive effect (β = 0.147, p = 0.005). Perceived green campus partially mediated the relationships between universalism, conformity and security, but not benevolence. Research limitations/implications – Findings have implications for higher education institution administrators and faculty members. Universities can leverage value-based appeals by designing greener campus spaces, integrating sustainability into curricula and promoting experiential learning opportunities that foster active student engagement. Originality/value – This study extends the literature on sustainability literacy by providing empirical evidence from Nigerian universities, a non-Western context. It contributes novel insights by integrating Schwartz’s theory of basic human values with social cognitive theory, highlighting both motivational orientations and social learning mechanisms, while introducing perceived green campus as a mediating factor. © 2025 Emerald Publishing Limited},
	language = {English},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Adebo, A. and Aladelusi, K.},
	year = {2025},
	keywords = {Campus facilities, Green campus, Higher education, Students, Sustainability literacy, Values},
	pages = {1--19},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{cederqvist_environmental_2025,
	title = {Environmental citizenship among {Swedish} higher education students: generational differences in perspectives on sustainability and environmental awareness},
	issn = {21906483 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024662580&doi=10.1007%2Fs13412-025-01079-4&partnerID=40&md5=e6d500e0e82cc919a2e31c8024f095cf},
	doi = {10.1007/s13412-025-01079-4},
	abstract = {Sweden has a long-standing tradition of incorporating Environmental Education (EE) and Education for Sustainable Development (ESD) into its school curriculum, which might suggest high pro-environmental behavior among higher education students. In this study, we have investigated the extent to which higher education students at a Swedish university express environmental citizenship behavior and, in relation to this, how environmental citizenship factors interact with demographic variables such as age and gender. The sample used in this study is composed of 371 students who responded to an online survey. The results indicate that the Swedish students in this study demonstrate relatively high eco-citizenship competences in all ages across several areas. However, the results also indicate a generational effect where the students older than 30 scored higher on values concerning respecting nature and protecting the environment, and they also seemed more willing to act as agents of change. The generational differences reflected in the results may be a consequence of the educational shift in Sweden over the years. From the late twentieth century, the discourse shifted from EE, which focused on ecological awareness and conservation, to ESD, which takes a broader view and integrates environmental, social, and economic sustainability. The results have implications for higher education institutions when designing education to promote pro-environmental behavior across different age groups, as there may be generational differences in perspectives on sustainability and environmental awareness. © The Author(s) 2025.},
	language = {English},
	journal = {Journal of Environmental Studies and Sciences},
	publisher = {Springer},
	author = {Cederqvist, A.-M. and Chaker, R. and Hajj-Hassan, M.},
	year = {2025},
	keywords = {Eco-citizenship, Education for sustainable development, Environmental citizenship, Environmental education, Higher education, Pro-environmental behavior},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: A.-M. Cederqvist; School of Education, Humanities and Social Sciences, Halmstad University, Halmstad, 301 18, Sweden; email: anne-marie.cederqvist@hh.se},
}

@incollection{de_machado_promoting_2025,
	title = {Promoting {Sustainability} in {HEIs}: {Implementing} the {ESG} {Agenda} as a {Strategy} to {Achieve} the {SDGs} of the {United} {Nations}},
	volume = {Part F1079},
	isbn = {21997373 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105024490223&doi=10.1007%2F978-3-031-96251-6_31&partnerID=40&md5=9d90642ff2466ef32bd116c998185c05},
	doi = {10.1007/978-3-031-96251-6_31},
	abstract = {In this chapter, we address the essential nature of integrating Environmental, Social, and Governance (ESG) principles into Higher Education Institutions (HEIs) as catalysts for advancing the Sustainable Development Goals (SDGs) of the United Nations. A “SUSTAINABLE HEI - ESG Framework” is proposed as a set of practical guidelines for implementing the ESG Agenda, engaging the academic community in adopting sustainable practices. This proposal is based on the premise that education for sustainable development can be profoundly enriched by integrating ESG concepts into all aspects of university life, including management, teaching, research, and outreach. However, the subject remains underexplored, with a significant knowledge gap about the impact of ESG practices on transforming both academic and local communities. Therefore, to operationalize this proposed objective, a systematic literature review is used as a method to identify both theoretical and practical guidelines for implementing this ESG Agenda in HEIs. The outcomes of this chapter highlight the transformative role of HEIs, not just as centers of education, but as active agents in promoting environmental, social, and governance sustainability. By adopting the ESG Agenda, HEIs commit to cultivating an environment that not only respects the economic, social, and environmental limits of future generations but also promotes holistic and sustainable development. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	language = {English},
	booktitle = {World {Sustain}. {Ser}.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	author = {de Machado, E.A.C. and da Silva Alves, R. and Dutra, A.R. and Guerra, J.B.S.O. and Birch, R.S.},
	year = {2025},
	note = {Journal Abbreviation: World Sustain. Ser.},
	keywords = {Education for sustainable development, ESG, Higher education institutions, Sustainable development, Sustainable development goals},
	pages = {537--552},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: E.A.C. de Machado; Graduate Program in Administration, University of Southern Santa Catarina (UNISUL), Tubarao, Brazil; email: eacmachado@gmail.com},
}

@incollection{broermann_transformative_2025,
	title = {Transformative {Language} {Teaching} {Practices} for {Sustainability} {Among} {Adult} {L2} {Learners} of {Swedish} in a {German} {University}: {The} {Case} {Study} as a {Teaching} {Method}},
	isbn = {9783031854934 (ISBN); 9783031854927 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023594888&doi=10.1007%2F978-3-031-85493-4_7&partnerID=40&md5=2b641b719485c395e659ae98c50a55a7},
	doi = {10.1007/978-3-031-85493-4_7},
	abstract = {Higher education institutions worldwide now consider Education for Sustainable Development a cross-cutting issue, with the development of competencies to promote sustainable development and global citizenship stated as one of their educational objectives. To explore how this can be implemented in language teaching and learning, the case study teaching method was used in two Swedish language courses in Germany conserning renewable energy and Indigenous peoples’ rights in the Sámi homelands. The study sought to determine whether and in what way the course had altered the students’ conceptions of sustainability. Another aim was to explore the extent to which deeper reflection and transformative learning could be identified as a consequence of the course. Data were obtained from student questionnaires and end-of-course reflective writings. The respondents appeared to have a reasonable understanding of sustainability concepts but acknowledged that their knowledge was relatively general and expressed a desire to learn more. They also reported having gained a more nuanced understanding of the complexity of sustainability issues. However, a deeper level of reflection was evident only in a minority of students. Overall, the results illustrate the necessity and students’ desire to address sustainability issues and the need for training in reflection to facilitate transformative learning. © 2025 The Editor(s) (if applicable) and The Author(s), under exclusive licence to Springer Nature Switzerland AG.},
	language = {English},
	booktitle = {Transformative {Language} {Teach}. for {Sustainability}: {From} {Theory} to {Practice}},
	publisher = {Springer Science+Business Media},
	author = {Broermann, M. and Kuusalu, S.-R. and Maijala, M.},
	year = {2025},
	note = {Journal Abbreviation: Transformative Language Teach. for Sustainability: From Theory to Practice},
	keywords = {Case-studies, Curricula, Education computing, Education for sustainable development, Education for Sustainable Development, High educations, Higher education, Language case studies, Language case study, Sapmi, Sápmi, Students, Sustainability issues, Sustainable development, Swedish teaching, Swedishs, Teaching, Teaching methods, Transformative learning},
	pages = {165--192},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: S.-R. Kuusalu; School of Languages and Translation Studies, University of Turku, Turku, Finland; email: srkbos@utu.fi},
}

@article{alvarez-vanegas_empowering_2025,
	title = {Empowering university teachers for education for sustainable development: the impact of a massive open online course},
	issn = {13504622 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105022692598&doi=10.1080%2F13504622.2025.2585868&partnerID=40&md5=28a78b0011e75061c739295908d8c155},
	doi = {10.1080/13504622.2025.2585868},
	abstract = {This study seeks to evaluate the efficacy of a massive open online course (MOOC) in promoting Education for Sustainable Development (ESD) competences among university teachers. An exploratory study was conducted using mixed methods under the constructive alignment approach. This involved the creation and delivery of a free MOOC focusing on ESD and offered to educators within Latin American higher education institutions. The constructive alignment approach and the CoDesignS ESD framework, supplemented with theoretical sustainability and ESD knowledge, guided the course. Data from 306 participants were collected and analysed, including pre–post surveys with follow-up assessment and participants’ feedback. The study revealed that university teachers exhibit substantial enthusiasm and motivation to engage with ESD concepts. A MOOC strategy shows promise in strengthening the cultivation of ESD competences among university teachers, especially when combined with hands-on practical components. Despite the need for training educators in ESD and the potential of online platforms to reach diverse audiences, the impact of digital education initiatives for ESD educator training remains largely unexplored. The study is also distinct in its focus on the Latin American context. © 2025 Informa UK Limited, trading as Taylor \& Francis Group.},
	language = {English},
	journal = {Environmental Education Research},
	publisher = {Routledge},
	author = {Álvarez-Vanegas, A. and Rieckmann, M. and Pérez, M.L. and Volante, L. and Aguirre, P.M.},
	year = {2025},
	keywords = {A Rounder Sense of Purpose, ESD competences, higher education institutions, MOOC, university teachers},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: A. Álvarez-Vanegas; Area of Natural Systems and Sustainability, Universidad EAFIT, Medellín, Colombia; email: aalvar17@eafit.edu.co},
}

