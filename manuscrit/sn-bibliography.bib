@article{castillo-elizondo_education_2025,
	title = {{EDUCATION} {FOR} {SUSTAINABLE} {DEVELOPMENT} {IN} {A} {HIGHER} {EDUCATION} {INSTITUTION} {IN} {NORTHEASTERN} {MEXICO}},
	volume = {50},
	issn = {03781844 (ISSN)},
	shorttitle = {{EDUCAÇÃO} {PARA} {O} {DESENVOLVIMENTO} {SUSTENTÁVEL} {EM} {UMA} {INSTITUIÇÃO} {DE} {ENSINO} {SUPERIOR} {NO} {NORDESTE} {DO} {MÉXICO}},
