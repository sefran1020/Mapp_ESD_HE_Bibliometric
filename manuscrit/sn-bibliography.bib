	note = {Journal Abbreviation: Digit., New Media, and Educ. for Sustain. Dev.},
	pages = {247--263},
	annote = {Export Date: 25 February 2026; Cited By: 1},
}

@article{baena-morales_analysing_2023,
	title = {Analysing the sustainability competencies of preservice teachers in {Spain}},
	volume = {15},
	issn = {20507003 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133154948&doi=10.1108%2FJARHE-02-2022-0040&partnerID=40&md5=8ea36fd0acdc8affb2cf41e2dbb5d8c0},
	doi = {10.1108/JARHE-02-2022-0040},
	abstract = {Purpose: Physical education has been described as an essential material to contribute to sustainable development. Therefore, it is necessary to examine the proficiency of higher education students in the three dimensions of sustainable development. This paper aims to analyse both the competences associated with the sustainability of preservice physical education teachers and the curriculum's influence on them. Design/methodology/approach: In total, 341 students (112 women) completed the validated Physical Education for Sustainable Development – Future Teacher PESD-FT questionnaire. This instrument assesses sustainable competences in its three dimensions (social, economic and environmental). In order to determine the influence of the curriculum on sustainability competences, the academic year studied was used as a variable. Variables such as gender, age and competitive experience in institutionalised sport were also considered in the statistical analysis. Findings: The results showed that the total set of students scored above average in their self-perception of competences associated with sustainable development in all three dimensions. The Mann–Whitney U test and Kruskal–Wallis statistics showed no differences attributed to gender and grade, respectively. Originality/value: This could help to rule out the influence of the curriculum as the main factor in the acquisition of these sustainable competences. However, greater competitive experience in institutionalised sports was associated with greater proficiency in social competence within sustainable development. © 2022, Emerald Publishing Limited.},
	language = {English},
	number = {3},
	journal = {Journal of Applied Research in Higher Education},
	publisher = {Emerald Publishing},
	author = {Baena-Morales, S. and García-Taibo, O. and Merma-Molina, G. and Ferriz-Valero, A.},
	year = {2023},
	keywords = {Competences, Curriculum, Physical education, Sustainable development, Sustainable development goals},
	pages = {731--744},
	annote = {Export Date: 25 February 2026; Cited By: 17; Correspondence Address: G. Merma-Molina; Department of General Didactics and Specific Didactics, University of Alicante, Alicante, Spain; email: gladys.merma@ua.es},
}

@incollection{el_bedawy_sustainability_2023,
	title = {Sustainability education: {A} review toward developing higher education for sustainable development},
	volume = {2-3},
	isbn = {9783031019494 (ISBN); 9783031019487 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198696454&doi=10.1007%2F978-3-031-01949-4_6&partnerID=40&md5=b7c285b2a11fb9e0645a7db11593d2a2},
	doi = {10.1007/978-3-031-01949-4_6},
	abstract = {Along the acknowledgment of the United Nations Decade of Education for Sustainable Development (2005-2014), sustainability education or education for sustainable development becomes progressively vital at the different educational levels and in particular for higher education. This remarkable importance reflects the urgency to cope with the requirements of sustainable development and global challenges through integrating the required sustainability principles within the educational context. This integration aims to empower and to inspire the new generations with a clear vision to take seriously the responsibility of maintaining a sustainable development. To shed the light on the crucial role that should be played by the higher education institution to support education for sustainable development, this chapter demonstrates a review as a guideline to set a good model of higher education for sustainable development, in order to constantly explore the effective tools to produce sustainability literacy for its graduates, highlighting the provided opportunities and the challenges that may occur. © The Author(s), 2023. All rights reserved.},
	language = {English},
