@inproceedings{abdildauly_education_2025,
	title = {Education for sustainable development: {Comparative} analysis of internship programs in preparing biology teachers},
	volume = {1544},
	isbn = {17551307 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105021214607&doi=10.1088%2F1755-1315%2F1544%2F1%2F012015&partnerID=40&md5=0e05f1f135fe166a1a8d2576bb7fdc2a},
	doi = {10.1088/1755-1315/1544/1/012015},
	abstract = {The issue of training highly qualified pedagogical staff continues to be of paramount importance, undergoing periodic transformations in response to the modernization and enrichment of approaches to teaching biological sciences. This research undertakes a comparative examination of educational frameworks in Kazakhstan, the Russian Federation, and the United States with regard to the preparation of future biology educators. It also outlines a conceptual model for enhancing students' research proficiency, formulating targeted recommendations derived from the analysis of these programs. The structure and scope of both academic and field-based internships were scrutinized, given their role in consolidating competencies and translating theoretical knowledge into practice. The necessity of fostering research-oriented skills in biology teacher preparation is substantiated. A review of school-level biology curricula served as the basis for proposing modules and subject areas essential for laboratory investigations, experimental modeling, and supervised research projects. Adopting these elements aligns with reformed education content, cultivating subject-specific expertise alongside functional literacy. The analysis is grounded in the European Credit Transfer System (ECTS) to ensure comparability across contexts. Findings highlight how well-structured internship programs foster subject knowledge, practical skills, and research capabilities, essential for promoting environmental literacy and supporting United Nations Sustainable Development Goal (SDG) 4.7 on Education for Sustainable Development (ESD). Based on this comparison, a model is proposed for integrating sustainability-related competencies into biology teacher training, ensuring future educators can address ecological and sustainability challenges in school curricula. The distinctive contribution of this work lies in its integrative comparative perspective and in the formulation of concrete recommendations for higher education institutions engaged in training biology teachers. © Published under licence by IOP Publishing Ltd.},
	language = {English},
	number = {1},
	booktitle = {{IOP} {Conf}. {Ser}. {Earth} {Environ}. {Sci}.},
	publisher = {Institute of Physics},
	author = {Abdildauly, A. and Bakhtaulova, A.S. and Mukasheva, D.M. and Haas, M.},
	editor = {Torres-Gutierrez, R. and Bazantes-Saltos, K. and Aviles-Castillo, F.},
	year = {2025},
	note = {Journal Abbreviation: IOP Conf. Ser. Earth Environ. Sci.},
	keywords = {biology teacher training, educational practice, ESD, field practice, research competencies, SDG 4.7, sustainability in education, teaching biology},
	annote = {Export Date: 25 February 2026; Cited By: 0; Correspondence Address: A. Abdildauly; Zhetysu University Named after I. Zhansugurov, Taldykorgan, Kazakhstan; email: alem.abdildauly@gmail.com; Conference name: International Conference on Technological Innovation, Sustainability and Environmental Conservation, TISEC 2025; Conference location: Tena; Conference date: 2025-09-04 through 2025-09-05},
}

@incollection{chaudhary_role_2025,
	title = {{THE} {ROLE} {OF} {HIGHER} {EDUCATION} {INSTITUTES} ({HEIs}) {IN} {REDUCING} {GENDER} {INEQUALITIES}},
	isbn = {9781835498064 (ISBN); 9781835498095 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019485352&doi=10.1108%2F978-1-83549-806-420251005&partnerID=40&md5=87a0d90eeef19b31a215c5b53bff855e},
	doi = {10.1108/978-1-83549-806-420251005},
	abstract = {Sustainable Development Goal (SDG) 10 aims to reduce inequality within and among countries and its targets address gender inequality challenges such as eliminating discrimination and violence against women and girls; and ending harmful practices like child marriage, female genital mutilation, and trafficking. SDG 10 targets that all women have equal access to economic resources, land, and property and equal opportunities in leadership positions. Education for Sustainable Development focuses on building a society equipped to address global social inequalities. Over time, universities have been creating curricula and pedagogical strategies to teach students about the effects of inequality. This chapter examines and highlights the role of higher education institutes (HEIs) in achieving SDG 10. Through secondary data analysis, this study used qualitative methods to explore the function of HEIs in advancing gender equality. HEIs can promote gendersensitive policies, gender mainstreaming, training, and awareness, and provide equal access to education. They can also facilitate research and collaborate with various stakeholders to lessen gender inequality and work to enable women's access to leadership positions. © 2025 The authors.},
