	year = {2025},
	note = {Journal Abbreviation: Educ. Asia-Pacific Reg.},
	keywords = {Corporate social responsibility, Green employment, Industry 4.0, Market of higher education, Market of work},
	pages = {85--91},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

