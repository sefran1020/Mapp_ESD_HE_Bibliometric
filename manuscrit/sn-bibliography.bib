	year = {2025},
	keywords = {discourse analysis, green skills, green VET, international organisations, policy, research},
	pages = {243--254},
	annote = {Export Date: 25 February 2026; Cited By: 7; Correspondence Address: A. Albertz; Chair of Business Education and International VET Research, University of Cologne, Cologne, Germany; email: annabell.albertz@uni-koeln.de},
}

