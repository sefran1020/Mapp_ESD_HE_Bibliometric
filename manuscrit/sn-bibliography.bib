	keywords = {“europe 2020” strategy, “Europe 2020” Strategy, \% reductions, Data mining, Energy efficiency, Energy-related process, Engineering education, Geographic information, Geographic information systems, GIS, Green manufacturing, Greenhouse gas emissions, Greenhouse gases, Inclusive growth, Industrial processs, Industrial research, Information systems, Research and development expenditure, Smart growth, Sustainable development, Sustainable growth},
