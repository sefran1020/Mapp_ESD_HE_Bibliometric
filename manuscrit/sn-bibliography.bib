@incollection{assalihee_reforming_2022,
	title = {Reforming {Religion}-{Based} {Higher} {Education} for {Sustainable} {Development}: {The} {Case} of {Islamic} {Studies} {International} {Program} at {Prince} of {Songkla} {University}},
	volume = {Part F2739},
	isbn = {25233084 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85172221789&doi=10.1007%2F978-3-031-07191-1_5&partnerID=40&md5=7ee360a91a9e6ec0a2c8672a574c4d41},
	doi = {10.1007/978-3-031-07191-1_5},
	abstract = {Twenty-first-century education has pedagogical influences on how Islamic Studies is taught, especially in Thailand, a home to Muslim minorities. While curricula are required to address national policies on career training, social uplifting, and economic prosperity, they are also expected to somewhat preserve core identities of Islamic Studies, which are to foster spiritual, moral, and ethical growth following the Islamic teachings. This study aimed to project critical milestones that the Faculty of Islamic Sciences has achieved as it reformed its curriculum and instruction by progressing away from traditional towards religion-based practices that match the educational needs for sustainable development. This study employed a qualitative approach, and the data were collected from the faculty administrators, the lecturers of the programme, and the students (including both Thai and international students). The findings were projected to firstly unveil new perspectives for Islamic Studies teachings that lead to practical insights and guidelines on alleviating existing Islamic Studies programmes and redesigning instructional strategies in response to sustainable development and secondly offer suggestions to higher education institutions and relevant educational agencies on sustainable development for higher education providing Islamic Studies in Thailand and abroad. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2022.},
	language = {English},
	booktitle = {Sustain. {Dev}. {Goals} {Ser}.},
	publisher = {Springer},
	author = {Assalihee, M. and Boonsuk, Y.},
	year = {2022},
	note = {Journal Abbreviation: Sustain. Dev. Goals Ser.},
	pages = {67--82},
	annote = {Export Date: 25 February 2026; Cited By: 2; Correspondence Address: M. Assalihee; Faculty of Islamic Sciences, Prince of Songkla University, Pattani, Thailand; email: muhammadafeefee.a@psu.ac.th},
}

@incollection{fernandez_herrero_sustainability_2022,
	title = {Sustainability {Training} {Evaluation} of {Spanish} {University} {Students}},
	isbn = {9783631892893 (ISBN); 9783631892909 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85153835238&partnerID=40&md5=4bc039efec256fcd162a7cad3563425f},
	abstract = {The evaluation of university students’ sustainability training is a key aspect of the integral incorporation of a sustainability framework within our universities. The emergence of various evaluation tools that respond to non- unified criteria and parameters makes it difficult to identify the needs of both institutions and members of the educational community, to establish concrete strategies to strengthen and consolidate Education for Sustainable Development in higher education. In this study, a total of 242 students from the social sciences branch of the University of Alicante completed an evaluation of their training in sustainability based on the instrument developed by Martínez and Hernández (2019). The descriptive and inferential analysis of the results suggest that the sustainability training of the student body is good, especially in the fields of knowledge appropriation and socioeconomic impact, while the relationship and university education result in less positive outcomes. Additionally, females seem to show better levels of sustainability training than males, particularly in the area of university education. The type of secondary school attended or the educational level of their parents did not significantly differ in their evaluation. © Peter Lang GmbH Internationaler Verlag der Wissenschaften Berlin 2022. All rights reserved.},
	language = {English},
	booktitle = {Education and the {Collective} {Construction} of {Knowl}.},
	publisher = {Peter Lang AG},
	author = {Fernández Herrero, J. and Martinez-Roig, R. and Gavilán-Martin, D.},
	year = {2022},
	note = {Journal Abbreviation: Education and the Collective Construction of Knowl.},
	keywords = {Education evaluation, Education for sustainable development, Gender roles, Higher education, Parent education, Sustainability},
	pages = {51--67},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

@article{carrio_exploring_2022,
	title = {Exploring innovative strategies in problem based learning to contribute to sustainable development: a case study},
	volume = {24},
	issn = {14676370 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85148515145&doi=10.1108%2FIJSHE-07-2021-0296&partnerID=40&md5=b5eae212cb6cde72b9eaa2c3ea052bce},
	doi = {10.1108/IJSHE-07-2021-0296},
	abstract = {Purpose: Higher education institutions (HEIs) have a great responsibility to put education for sustainable development at the centre of their work. Curricula should therefore start to incorporate the sustainable development goals (SDGs) and key competencies in sustainability, and research should be carried out to determine effective learning methods for this. This study aims to explore the usefulness of problem-based learning (PBL) approaches to train biomedical students in sustainability and to provide some recommendations for the design and implementation of new PBL-SDG scenarios. Design/methodology/approach: Two PBL-SDG scenarios were designed, implemented and evaluated for 110 students of human biology degree. Learning outcomes and student perceptions of this approach were analysed through questionnaires, student productions, non-participant observation and focus groups. Findings: The results show that the PBL-SDG scenarios effectively addressed several SDGs and sustainability competencies in a transversal, collaborative and innovative manner. According to student perceptions, the elements that contributed most to the development of these competencies were emotional involvement with the scenario, reflection on their own actions, freedom to approach the problem and tutors who empowered them with their proposals. Originality/value: The PBL-SDG approach presented in this study is an example of a pedagogical strategy that can help HEIs educate their learners as key change agents. The findings of this study provide evidence for this important aspect and give guidelines and strategies to successfully designing and implementing such methodologies in biomedical education. © 2022, Mar Carrió Llach and Maria Llerena Bastida.},
	language = {English},
	number = {9},
	journal = {International Journal of Sustainability in Higher Education},
	publisher = {Emerald Publishing},
	author = {Carrió, M. and Llerena Bastida, M.},
	year = {2022},
	keywords = {Education for sustainable development, Health sciences studies, Problem-based learning, Sustainable competencies, Sustainable development goals (SDGs)},
	pages = {159--177},
	annote = {Export Date: 25 February 2026; Cited By: 25; Correspondence Address: M. Carrió Llach; Department of Medicine and Life Sciences, Universitat Pompeu Fabra, Barcelona, Spain; email: mar.carrio@upf.edu},
}

