@incollection{de_frece_promoting_2025,
	title = {Promoting situated change towards sustainability and climate action through post-digital online distance learning pedagogy},
	isbn = {9781032418933 (ISBN); 9781040330838 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001375899&doi=10.4324%2F9781003360254-7&partnerID=40&md5=7a4d6bb0edcb09887e5b4934c7e02bb9},
	doi = {10.4324/9781003360254-7},
	abstract = {The Centre for Development, Environment and Policy at School of Oriental and African Studies (SOAS), University of London, has transformed its postgraduate online distance learning programmes to deliver formative assessment and active learning through its MSc Sustainable Development and MSc Climate Change and Development programmes. Changes to pedagogy and assessment implemented from 2022 have transformed learning from didactic distance learning to post-digital action-oriented and values-driven online programmes aligned with education for sustainable development principles that unpack orthodoxy and promote situated sustainability and climate action among learners. Whilst digital technologies succeed in facilitating learning at distance, transcending the digital space is central to post-digital learning. Some key insights include the following: students are geographically remote but want to learn together; connected formative feedback from tutors and peers enhances learning outcomes and progression; formative assessment, activities, and learning resources require alignment, both constructively and in time, to facilitate a scaffolded learning journey over the study session; student interaction and critical engagement online promote the development of diverse key skills and competencies; and students are more satisfied engaging in a post-digital environment and find the process both challenging and rewarding. © 2025 selection and editorial matter, Sam Elkington and Alastair Irons.},
	language = {English},
	booktitle = {Form. {Assess}. and {Feedback} in {Post}-{Digital} {Learn}. {Environ}.: {Discip}. {Case} {Stud}. in {High}. {Educ}.},
	publisher = {Taylor and Francis},
	author = {de Frece, A. and Taplin, R.},
	year = {2025},
	note = {Journal Abbreviation: Form. Assess. and Feedback in Post-Digital Learn. Environ.: Discip. Case Stud. in High. Educ.},
	pages = {59--68},
	annote = {Export Date: 25 February 2026; Cited By: 0},
}

