@article{bulut_teachers_2025,
	title = {Teachers’ {Beliefs} {About} {Education} for {Sustainable} {Development}: {Challenges} and {Opportunities} †},
	volume = {17},
	issn = {20711050 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105014284736&doi=10.3390%2Fsu17167552&partnerID=40&md5=5587bc432282aaa80c4c98098268dec5},
	doi = {10.3390/su17167552},
	abstract = {The aim of this study was to examine teachers’ belief levels regarding education for sustainable development (ESD), to identify the factors behind these beliefs, and to reveal their suggestions for improving the quality of ESD. The study employed an explanatory sequential mixed-methods design. Data were collected from 409 teachers working at primary and secondary schools in Türkiye through the “Beliefs About Education for Sustainable Development Scale” and semi-structured interviews. The quantitative data were analyzed using an independent samples t-test, one-way Analysis of Variance (ANOVA), and Pearson product-moment correlation, and the qualitative data were analyzed through content analysis. The results indicated that the participants’ beliefs in ESD practices were high, but these beliefs were negatively affected by challenges due to SD goals, policymakers, students, and parents. In addition, the participants made recommendations for improving the quality of ESD to policymakers, the Turkish Council of Higher Education, the Ministry of National Education, and their colleagues. The findings of the study present significant implications for policymakers and educators for more effective implementation of ESD in the education system. © 2025 by the authors.},
	language = {English},
	number = {16},
	journal = {Sustainability (Switzerland)},
	publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
	author = {Bulut, B. and Elci Oksuzoglu, I.},
	year = {2025},
	keywords = {belief, education, education for sustainable development, educational development, policy making, quantitative analysis, sustainable development, Sustainable Development Goal, teacher, teacher training, Turkey},
	annote = {Export Date: 25 February 2026; Cited By: 3; Correspondence Address: B. Bulut; Social Studies Education Department, Faculty of Education, Firat University, Elazig, 23119, Turkey; email: birolbulut23@g.ucla.edu},
}

@article{de_angelis_walking_2025,
	title = {Walking the {Talk} on {Education} for {Sustainable} {Development}: {The} {Value} of {Circular} {Economy} {Education} in the {Age} of {Complexity}},
	volume = {5},
	issn = {2730597X (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105003448021&doi=10.1007%2Fs43615-025-00577-5&partnerID=40&md5=a775e2040c512e69c3cf6dfba36b2f1b},
	doi = {10.1007/s43615-025-00577-5},
	abstract = {In the wake of contemporary societal grand challenges, the circular economy has emerged as a plausible vision towards a more responsible, resilient and prosperous future. Embraced by several national and supranational policies and espoused by incumbents and innovators in the business context, circular economy thinking has also made inroads in the academic literature. Scholars from across disciplinary fields have contributed to a lively and vibrant research community. However, while education is amongst the systemic conditions enabling the transition towards the circular economy and higher education plays a pivotal role as a global stakeholder, the burgeoning circular economy literature has remained almost silent on how to integrate circular economy into higher education, on its benefits and implications. Based on a course experience in higher education, this article proposes a pedagogical approach for introducing the next generation of business leaders to circular economy thinking and its relevance for flourishing within planetary boundaries. The benefits of this proposal are twofold. From an operational viewpoint, drawing on the i5 Principles for Responsible Management Education Playbook, an open access resource specifically designed for transforming business education and developing more responsible leaders, this article enriches the emerging literature at the intersection between education, the circular economy and the socio-ecological approach to management education and scholarship. From a conceptual viewpoint, it shows that this approach to circular economy teaching is in line with recent calls from higher education scholarship to promote an ecological and imaginative vision of higher education. © The Author(s) 2025.},
	language = {English},
	number = {4},
	journal = {Circular Economy and Sustainability},
	publisher = {Springer Nature},
	author = {de Angelis, R. and Ianulardo, G.},
	year = {2025},
	keywords = {Circular Economy, Responsible Management Education, Societal Grand Challenges, Systems Thinking},
	pages = {3305--3316},
	annote = {Export Date: 25 February 2026; Cited By: 1; Correspondence Address: R. De Angelis; Cardiff University Business School, Cardiff, Aberconway Building Colum Drive, CF10 3EU, United Kingdom; email: deangelisr@cardiff.ac.uk},
}

@incollection{chakkaravarthy_enhancing_2025,
	title = {Enhancing doctoral education for sustainable development on strategies for curriculum and research integration},
	isbn = {9798337302270 (ISBN); 9798337302256 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013244843&doi=10.4018%2F979-8-3373-0225-6.ch011&partnerID=40&md5=35ff4635914b40b17d90b5f2892bbacb},
	doi = {10.4018/979-8-3373-0225-6.ch011},
	abstract = {The urgent need for sustainable development has made it essential for higher education institutions to equip future researchers with the knowledge and skills to address global environmental, economic, and social challenges. This paper explores strategies for enhancing doctoral education by integrating sustainability into both curriculum design and research methodologies. It argues that sustainability should not only be a topic within certain disciplines but a cross-cutting theme that influ¬ences all doctoral programs. Key strategies discussed include the incorporation of sustainability-focused content across doctoral curricula, fostering interdisciplinary collaboration, and encouraging action-oriented research that connects academic theory with real-world problems. The paper further examines how institutions can create environments that support sustainability-oriented research, including the development of partnerships with industry, government, and non-governmental organizations. © 2026, IGI Global Scientific Publishing. All rights reserved.},
