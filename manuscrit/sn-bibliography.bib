	isbn = {9781799821243 (ISBN); 9781799821267 (ISBN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85136886803&doi=10.4018%2F978-1-7998-2124-3.ch011&partnerID=40&md5=24222d0617a4dc744106c3bdcd2f72df},
