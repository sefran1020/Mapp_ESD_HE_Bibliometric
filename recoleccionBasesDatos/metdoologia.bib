	title = {{ECONOMIC} {GROWTH} {AND} {ITS} {INFLUENCE} {ON} {ENVIRONMENT} {SUSTAINABILITY}: {A} {BIBLIOMETRIC} {ANALYSIS} {USING} {VOSVIEWER} {APPLICATION}},
	volume = {10},
