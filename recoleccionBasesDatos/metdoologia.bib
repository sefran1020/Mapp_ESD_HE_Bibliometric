	journal = {Eastern-European Journal of Enterprise Technologies},
	publisher = {Technology Center},
	author = {Xu, Huilin and Kuchansky, Alexander and Gladka, Myroslava},
	year = {2021},
	keywords = {Multicriterial problem of choice, Scientific project, Scientometric analysis, Subject of scientific activity},
	pages = {93--100},
