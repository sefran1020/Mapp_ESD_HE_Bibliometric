	pages = {279--283},
	file = {Texto completo:E\:\\Zotero\\storage\\RHGVRW8W\\Wang et al. - 2020 - Research on evaluation methods of scientific research performance.pdf:application/pdf},
}

@article{marzi_three_2020,
	title = {A {Three} {Decade} {Mixed}-{Method} {Bibliometric} {Investigation} of the {IEEE} {Transactions} on {Engineering} {Management}},
